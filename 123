function getCalendarMeetingClass(meeting) {
  if (meeting.status === "Отменена") return "cancelled";
  if (meeting.status === "Перенесена") return "rescheduled";
  return "planned";
}

function getCalendarMeetingCandidate(meeting) {
  const existing = allCandidates.find(candidate =>
    String(candidate.candidateId || "") ===
    String(meeting.candidateId || "")
  );

  return {
    ...(existing || {}),
    meetingId:meeting.meetingId,
    candidateId:meeting.candidateId,
    name:meeting.name || existing?.name || "Без ФИО",
    phone:meeting.phone || existing?.phone || "",
    specialty:meeting.specialty || existing?.specialty || "",
    meeting:meeting.meeting,
    status:existing?.status || "Записан",
    object:meeting.object || existing?.object || "Не указан",
    comment:meeting.comment || existing?.comment || "",
    source:meeting.source || existing?.source || ""
  };
}



<!DOCTYPE html>
<html lang="ru">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#10141d">
  <title>STROY PODRYAD — Recruitment</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg:#10141d;
      --sidebar:#141a25;
      --panel:#1a2230;
      --panel2:#202a3a;
      --border:#2b3545;
      --text:#edf0f5;
      --muted:#8995a8;
      --gold:#d7c49b;
      --gold-bg:rgba(215,196,155,.12);
      --blue:#a9bfdc;
      --green:#9bc9ae;
      --red:#df9292;
      --radius:15px;
    }

    * { box-sizing:border-box; }

    body {
      margin:0;
      min-height:100vh;
      background:var(--bg);
      color:var(--text);
      font-family:'Manrope',Arial,sans-serif;
      font-size:14px;
    }

    button,input,select,textarea { font:inherit; }
    button { cursor:pointer; }
    button:disabled { cursor:not-allowed;opacity:.55;transform:none!important; }

    .app {
      min-height:100vh;
      display:grid;
      grid-template-columns:250px minmax(0,1fr);
    }

    .sidebar {
      background:var(--sidebar);
      border-right:1px solid var(--border);
      padding:27px 17px;
      display:flex;
      flex-direction:column;
      min-height:100vh;
      position:sticky;
      top:0;
      height:100vh;
    }

    .brand {
      display:flex;
      align-items:center;
      gap:12px;
      padding:0 9px;
      margin-bottom:42px;
    }

    .brand-icon {
      width:42px;height:42px;border-radius:12px;
      background:linear-gradient(145deg,#354257,#202a39);
      border:1px solid #48566c;
      display:grid;place-items:center;
      color:var(--gold);font-size:21px;font-weight:800;
    }

    .brand-name { font-size:19px;font-weight:800;letter-spacing:2px; }
    .brand-sub { color:var(--muted);font-size:9px;letter-spacing:2px;margin-top:2px; }
    .nav-label { color:#667286;font-size:10px;font-weight:800;letter-spacing:1.7px;padding:0 12px;margin:0 0 12px; }
    .nav { display:grid;gap:6px; }

    .nav-btn {
      border:1px solid transparent;background:transparent;color:#9ba6b7;
      border-radius:10px;padding:12px;display:flex;align-items:center;
      gap:12px;text-align:left;width:100%;transition:.2s;
    }

    .nav-btn:hover { background:#202a38;color:white; }
    .nav-btn.active { background:var(--gold-bg);border-color:rgba(215,196,155,.2);color:var(--gold); }
    .nav-icon { width:21px;text-align:center;font-size:17px; }
    .sidebar-bottom { margin-top:auto;padding:15px 10px 0; }

    .system-status {
      display:flex;align-items:center;gap:9px;color:var(--muted);
      font-size:11px;border-top:1px solid var(--border);padding-top:17px;
    }

    .status-dot {
      width:7px;height:7px;border-radius:50%;background:var(--green);
      box-shadow:0 0 10px rgba(155,201,174,.4);
    }

    .main {
      min-width:0;padding:34px 42px 60px;
      max-width:1700px;width:100%;margin:0 auto;
    }

    .topbar {
      display:flex;justify-content:space-between;align-items:center;
      gap:20px;margin-bottom:35px;
    }

    .eyebrow { color:var(--gold);font-size:10px;letter-spacing:2px;font-weight:800;margin-bottom:8px; }
    h1 { font-size:27px;letter-spacing:-.8px;margin:0;font-weight:800; }
    .top-date { color:var(--muted);font-size:12px;margin-top:7px; }
    .top-right { display:flex;align-items:center;gap:12px; }

    .project-chip {
      border:1px solid var(--border);background:var(--panel);
      border-radius:10px;padding:10px 14px;color:#c3ccda;font-size:11px;
    }

    .avatar {
      width:39px;height:39px;border-radius:12px;display:grid;place-items:center;
      background:#303b4e;color:var(--gold);font-weight:800;
    }

    .page { display:none; }
    .page.active { display:block;animation:appear .25s ease; }

    @keyframes appear {
      from { opacity:0;transform:translateY(5px); }
      to { opacity:1;transform:translateY(0); }
    }

    .stats-grid {
      display:grid;grid-template-columns:repeat(4,minmax(0,1fr));
      gap:16px;margin-bottom:25px;
    }

    .stat-card {
      background:var(--panel);border:1px solid var(--border);
      border-radius:var(--radius);padding:21px;min-width:0;
      position:relative;overflow:hidden;
    }

    .stat-card::after {
      content:"";position:absolute;width:85px;height:85px;
      right:-35px;top:-38px;border-radius:50%;
      background:var(--glow,rgba(215,196,155,.07));filter:blur(5px);
    }

    .stat-label { color:var(--muted);font-size:12px;font-weight:600; }
    .stat-number { font-size:34px;font-weight:800;letter-spacing:-1.5px;margin-top:13px;color:var(--number-color,var(--text)); }
    .stat-caption { color:#687589;font-size:10px;margin-top:5px; }

    .section-card {
      background:var(--panel);border:1px solid var(--border);
      border-radius:var(--radius);overflow:hidden;min-width:0;
    }

    .section-head {
      padding:20px 22px;display:flex;align-items:center;
      justify-content:space-between;gap:15px;border-bottom:1px solid var(--border);
    }

    .section-title { font-size:14px;font-weight:800; }
    .section-subtitle { color:var(--muted);font-size:11px;margin-top:4px; }
    .text-btn { background:transparent;border:0;color:var(--gold);font-size:11px;font-weight:700;padding:8px; }

    .table-wrap { width:100%;overflow-x:auto; }
    table { width:100%;border-collapse:collapse;min-width:680px; }

    th {
      color:#778397;text-align:left;font-size:10px;letter-spacing:.8px;
      font-weight:800;padding:14px 18px;white-space:nowrap;
    }

    td {
      padding:15px 18px;border-top:1px solid rgba(43,53,69,.7);
      color:#cbd2dd;font-size:12px;vertical-align:middle;
    }

    tbody tr:hover { background:rgba(255,255,255,.018); }
    .candidate-name { font-weight:700;color:#eef0f4;font-size:12px; }
    .candidate-phone { color:var(--muted);font-size:11px;margin-top:4px; }

    .phone-link {
      color:#cbd2dd;text-decoration:none;
      border-bottom:1px dashed rgba(169,191,220,.45);
      transition:.2s;
    }

    .phone-link:hover { color:var(--gold); }

    .status-select {
      background:#151c27;border:1px solid var(--border);color:#cbd2dd;
      border-radius:8px;padding:7px 9px;font-size:10px;max-width:180px;
    }

    .status-select option { background:#151c27;color:#cbd2dd; }
    .status-select.status-working { color:#4ade80;border-color:#166534; }
    .status-select.status-trial { color:#facc15;border-color:#854d0e; }
    .status-select.status-arrived { color:#60a5fa;border-color:#1e40af; }
    .status-select.status-rejected { color:#f87171;border-color:#991b1b; }
    .status-select.status-new { color:#cbd5e1;border-color:#475569; }

    .toolbar {
      display:flex;gap:10px;align-items:center;flex-wrap:wrap;
      padding:17px 20px;border-bottom:1px solid var(--border);
    }

    .search-box { flex:1;min-width:190px;position:relative; }
    .search-box input { padding-left:37px; }
    .search-symbol { position:absolute;left:13px;top:11px;color:#718096;font-size:15px; }

    .control {
      height:42px;border-radius:9px;border:1px solid var(--border);
      background:#131a25;color:var(--text);padding:0 12px;
      outline:none;min-width:140px;
    }

    .control:focus,.field-control:focus { border-color:#8f9eb5; }

    .primary-btn {
      border:1px solid #d9c69e;background:var(--gold);color:#242a33;
      border-radius:9px;padding:12px 17px;font-weight:800;
      font-size:11px;transition:.2s;
    }

    .primary-btn:hover { background:#e6d6b4;transform:translateY(-1px); }

    .secondary-btn {
      border:1px solid var(--border);background:#202a39;color:#c7d0dd;
      border-radius:9px;padding:11px 14px;font-size:11px;
      font-weight:700;transition:.2s;
    }

    .secondary-btn:hover { background:#29364a; }

    .quick-actions {
      display:flex;gap:7px;align-items:center;flex-wrap:wrap;
      margin-top:10px;
    }

    .quick-btn {
      display:inline-flex;align-items:center;justify-content:center;gap:6px;
      min-height:34px;padding:7px 10px;border-radius:8px;
      border:1px solid var(--border);background:#202a39;color:#cbd2dd;
      font-size:10px;font-weight:700;text-decoration:none;transition:.2s;
    }

    .quick-btn:hover { background:#2a374a;transform:translateY(-1px); }
    .quick-btn.call { color:#a9d7b7;border-color:rgba(155,201,174,.3); }
    .quick-btn.max { color:#b9c9ed;border-color:rgba(169,191,220,.3); }
    .quick-btn.copy { color:#d7c49b;border-color:rgba(215,196,155,.3); }

    .today-time {
      display:inline-flex;align-items:center;gap:6px;
      color:var(--gold);font-weight:800;font-size:12px;
      white-space:nowrap;
    }

    .today-card {
      background:#151d29;border:1px solid var(--border);
      border-radius:11px;padding:15px;min-width:0;
    }

    .today-card-top {
      display:flex;justify-content:space-between;align-items:flex-start;gap:10px;
    }

    .today-card-name { font-size:13px;font-weight:800;overflow-wrap:anywhere; }
    .today-card-specialty { color:var(--muted);font-size:11px;margin-top:5px; }
    .today-card-time { color:var(--gold);font-weight:800;font-size:12px;white-space:nowrap; }
    .today-card-object { color:var(--muted);font-size:10px;margin-top:9px; }
    .today-card-status { margin-top:10px; }

    .today-mobile {
      display:none;padding:12px;gap:10px;
    }

    .form-layout {
      display:grid;grid-template-columns:minmax(0,1fr) 300px;
      gap:18px;align-items:start;
    }

    .form-panel {
      background:var(--panel);border:1px solid var(--border);
      border-radius:var(--radius);padding:25px;
    }

    .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:19px; }
    .field { display:flex;flex-direction:column;gap:8px;min-width:0; }
    .field.full { grid-column:1/-1; }
    .field label { color:#aeb8c7;font-size:11px;font-weight:700; }

    .field-control {
      width:100%;height:45px;border:1px solid var(--border);
      border-radius:9px;background:#121923;color:white;
      padding:0 12px;outline:none;min-width:0;
    }

    textarea.field-control { height:95px;padding:12px;resize:vertical; }
    .field-hint { color:#687589;font-size:10px;line-height:1.6; }
    .form-actions { display:flex;gap:10px;margin-top:23px; }
    .form-actions button { min-height:44px; }

    .info-panel {
      background:#1a2230;border:1px solid var(--border);
      border-radius:var(--radius);padding:21px;
    }

    .info-panel h3 { font-size:13px;margin:0 0 17px; }
    .info-line { display:flex;gap:10px;margin-bottom:15px;color:#aab5c5;font-size:11px;line-height:1.6; }
    .info-line span:first-child { color:var(--gold); }

    .empty { padding:40px 20px;text-align:center;color:var(--muted);font-size:12px; }
    .loading { padding:30px;text-align:center;color:var(--muted);font-size:12px; }

    .message {
      display:none;padding:13px 15px;border-radius:9px;
      margin-top:16px;font-size:12px;line-height:1.5;white-space:pre-line;
    }

    .message.success {
      display:block;color:var(--green);background:rgba(155,201,174,.09);
      border:1px solid rgba(155,201,174,.2);
    }

    .message.error {
      display:block;color:var(--red);background:rgba(223,146,146,.08);
      border:1px solid rgba(223,146,146,.2);
    }

    .count-label { color:var(--muted);font-size:11px;padding:0 20px 15px; }

    .mobile-candidates { display:none;padding:12px;gap:10px; }

    .mobile-candidate {
      background:#151d29;border:1px solid var(--border);
      border-radius:11px;padding:14px;
    }

    .mobile-candidate-top { display:flex;justify-content:space-between;gap:10px;align-items:flex-start; }
    .mobile-candidate-name { font-size:13px;font-weight:800;overflow-wrap:anywhere; }
    .mobile-candidate-details { color:var(--muted);font-size:11px;line-height:1.8;margin-top:9px;white-space:pre-line; }
    .mobile-candidate .status-select { margin-top:12px;width:100%;max-width:none;height:38px; }

    .candidate-actions { display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px; }
    .candidate-actions .secondary-btn { padding:9px 12px; }
/* =========================
   КАЛЕНДАРЬ
========================= */

.calendar-toolbar {
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:15px;
  padding:17px 20px;
  border-bottom:1px solid var(--border);
}

.calendar-navigation {
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}

.calendar-period {
  font-size:16px;
  font-weight:800;
  color:var(--text);
  margin-left:8px;
  text-transform:capitalize;
}

.calendar-view-switch {
  display:flex;
  gap:4px;
  padding:4px;
  background:#121923;
  border:1px solid var(--border);
  border-radius:10px;
}

.calendar-view-btn {
  border:0;
  background:transparent;
  color:var(--muted);
  padding:9px 13px;
  border-radius:7px;
  font-size:11px;
  font-weight:800;
}

.calendar-view-btn.active {
  background:var(--gold-bg);
  color:var(--gold);
}

.calendar-legend {
  display:flex;
  flex-wrap:wrap;
  gap:17px;
  padding:14px 20px;
  color:var(--muted);
  font-size:10px;
  border-bottom:1px solid var(--border);
}

.calendar-legend span {
  display:flex;
  align-items:center;
  gap:7px;
}

.legend-dot {
  display:inline-block;
  width:8px;
  height:8px;
  border-radius:50%;
}

.legend-dot.planned { background:#a9bfdc; }
.legend-dot.rescheduled { background:#d7c49b; }
.legend-dot.cancelled { background:#df9292; }

.calendar-month {
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
}

.calendar-weekday {
  padding:13px 5px;
  text-align:center;
  color:var(--muted);
  font-size:10px;
  font-weight:800;
  border-bottom:1px solid var(--border);
}

.calendar-day {
  min-height:115px;
  padding:9px;
  border-right:1px solid rgba(43,53,69,.6);
  border-bottom:1px solid rgba(43,53,69,.6);
  cursor:pointer;
  min-width:0;
  transition:background .15s;
}

.calendar-day:hover {
  background:rgba(255,255,255,.035);
}

.calendar-day.other-month {
  opacity:.35;
}

.calendar-day.today {
  background:rgba(215,196,155,.055);
}

.calendar-day.selected {
  box-shadow:inset 0 0 0 1px var(--gold);
  background:rgba(215,196,155,.07);
}

.calendar-day-number {
  font-size:12px;
  font-weight:800;
  margin-bottom:8px;
}

.calendar-day.today .calendar-day-number {
  color:var(--gold);
}

.calendar-event {
  display:block;
  width:100%;
  text-align:left;
  border:0;
  border-left:3px solid #a9bfdc;
  border-radius:4px;
  padding:5px 6px;
  margin-bottom:4px;
  background:rgba(169,191,220,.12);
  color:#dce6f4;
  font-size:9px;
  line-height:1.4;
  overflow:hidden;
  text-overflow:ellipsis;
  cursor:pointer;
}

.calendar-event.rescheduled {
  border-left-color:#d7c49b;
  background:rgba(215,196,155,.12);
  color:#e8d9b7;
}

.calendar-event.cancelled {
  border-left-color:#df9292;
  background:rgba(223,146,146,.1);
  color:#e5b2b2;
  text-decoration:line-through;
}

.calendar-more {
  color:var(--muted);
  font-size:9px;
  padding:3px 5px;
}

.calendar-week {
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
}

.calendar-week-column {
  min-width:0;
  min-height:260px;
  padding:9px 6px;
  border-right:1px solid var(--border);
}

.calendar-week-column:last-child {
  border-right:0;
}

.calendar-week-column.selected {
  background:rgba(215,196,155,.045);
}

.calendar-week-date {
  text-align:center;
  padding:9px 2px 13px;
  border-bottom:1px solid var(--border);
  margin-bottom:10px;
  cursor:pointer;
}

.calendar-week-date strong {
  display:block;
  font-size:17px;
}

.calendar-week-date span {
  color:var(--muted);
  font-size:9px;
  text-transform:uppercase;
}

.calendar-week-date.today strong {
  color:var(--gold);
}

.calendar-day-layout {
  padding:15px;
}

.calendar-day-heading {
  font-size:13px;
  font-weight:800;
  margin-bottom:15px;
}

.calendar-slot {
  display:grid;
  grid-template-columns:65px minmax(0,1fr);
  min-height:65px;
  border-top:1px solid rgba(43,53,69,.65);
}

.calendar-slot-time {
  padding:12px 8px 0 0;
  color:var(--muted);
  font-size:10px;
  font-weight:700;
}

.calendar-slot-content {
  padding:6px;
  min-width:0;
  border-left:1px solid var(--border);
}

.calendar-slot .calendar-event {
  font-size:11px;
  padding:8px 10px;
  margin-bottom:5px;
}

.calendar-empty-day {
  padding:30px 15px;
  text-align:center;
  color:var(--muted);
  font-size:11px;
}

.calendar-count {
  color:var(--muted);
  font-size:10px;
  padding:13px 20px;
  border-top:1px solid var(--border);
}

.calendar-event:focus-visible,
.calendar-day:focus-visible,
.calendar-view-btn:focus-visible {
  outline:2px solid var(--gold);
  outline-offset:-2px;
}

@media(max-width:700px) {
  .calendar-toolbar {
    align-items:stretch;
    padding:13px;
  }

  .calendar-navigation {
    width:100%;
    justify-content:space-between;
  }

  .calendar-period {
    font-size:13px;
    margin-left:0;
  }

  .calendar-view-switch {
    width:100%;
  }

  .calendar-view-btn {
    flex:1;
  }

  .calendar-legend {
    padding:12px;
    gap:10px;
    font-size:9px;
  }

  .calendar-day {
    min-height:76px;
    padding:5px 3px;
  }

  .calendar-day-number {
    font-size:10px;
    margin-bottom:5px;
  }

  .calendar-event {
    font-size:8px;
    padding:4px 3px;
    border-left-width:2px;
  }

  .calendar-more {
    font-size:8px;
    padding:2px;
  }

  .calendar-week {
    grid-template-columns:repeat(7,minmax(95px,1fr));
  }

  .calendar-week-wrapper {
    overflow-x:auto;
  }

  .calendar-week-column {
    min-height:220px;
  }

  .calendar-day-layout {
    padding:10px;
  }

  .calendar-slot {
    grid-template-columns:48px minmax(0,1fr);
  }

  .calendar-count {
    padding:12px;
  }
}
    @media(max-width:1100px) {
      .main { padding:28px 25px 50px; }
      .stats-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .form-layout { grid-template-columns:1fr; }
    }

    @media(max-width:700px) {
      .app { display:block; }

      .sidebar {
        position:fixed;z-index:20;top:auto;bottom:0;left:0;right:0;
        width:100%;height:auto;min-height:0;
        padding:8px 8px calc(8px + env(safe-area-inset-bottom));
        border-right:0;border-top:1px solid var(--border);
        background:rgba(20,26,37,.97);backdrop-filter:blur(15px);
      }

      .brand,.nav-label,.sidebar-bottom { display:none; }
      .nav { display:grid;grid-template-columns:repeat(4,1fr);gap:5px; }

      .nav-btn {
        justify-content:center;flex-direction:column;
        gap:3px;padding:8px 4px;font-size:9px;border-radius:9px;
      }

      .nav-icon { font-size:18px;width:auto; }
      .main { padding:22px 15px 105px; }
      .topbar { align-items:flex-start;margin-bottom:24px; }
      h1 { font-size:23px; }
      .project-chip { display:none; }
      .stats-grid { gap:10px;margin-bottom:16px; }
      .stat-card { padding:15px; }
      .stat-number { font-size:28px; }
      .stat-label { font-size:10px; }
      .section-head { padding:16px; }
      .toolbar { padding:13px;gap:8px; }
      .search-box { flex-basis:100%; }
      .toolbar .control { flex:1;min-width:0;width:100%; }
      .table-wrap { display:none; }
      .today-mobile { display:grid; }
      .mobile-candidates { display:grid; }
      .form-panel { padding:17px; }
      .form-grid { grid-template-columns:1fr;gap:15px; }
      .field.full { grid-column:auto; }
      .form-actions { flex-direction:column; }
      .form-actions button { width:100%; }
      .info-panel { padding:17px; }
      .quick-btn { flex:1; }

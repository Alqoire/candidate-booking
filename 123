<script>
"use strict";

const STATUSES = [
  "Новый",
  "Записан",
  "Приехал на объект",
  "На испытательном сроке",
  "Работает",
  "Отказ",
  "Не приехал",
  "Не прошёл испытательный срок"
];

let allCandidates = [];
let isLoadingCandidates = false;
let isSubmittingCandidate = false;

let calendarDate = new Date();
let calendarView = "month";
let calendarMeetings = [];
let isLoadingCalendar = false;
let calendarRequestNumber = 0;

const pageTitles = {
  dashboard: "Панель управления",
  candidates: "База кандидатов",
  calendar: "Календарь встреч",
  add: "Добавление кандидата"
};

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

function makeText(tag, className, value) {
  const element = document.createElement(tag);
  if (className) element.className = className;
  element.textContent = value ?? "";
  return element;
}

function getTomorrow() {
  const date = new Date();
  date.setDate(date.getDate() + 1);
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0")
  ].join("-");
}

function getTodayKey() {
  const date = new Date();
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0")
  ].join("-");
}

/*
 * Поддерживает даты вида:
 * 23.11.2026 15:00
 * 23.11.2026 в 15:00
 * 2026-11-23T15:00
 * 2026-11-23 15:00
 */
function parseMeetingDate(value) {
  if (!value) return null;

  const text = String(value).trim();

  let match = text.match(/^(\d{2})\.(\d{2})\.(\d{4})/);

  if (match) {
    return [
      match[3],
      match[2],
      match[1]
    ].join("-");
  }

  match = text.match(/^(\d{4})-(\d{2})-(\d{2})/);

  if (match) {
    return [
      match[1],
      match[2],
      match[3]
    ].join("-");
  }

  const parsed = new Date(text);

  if (!Number.isNaN(parsed.getTime())) {
    return [
      parsed.getFullYear(),
      String(parsed.getMonth() + 1).padStart(2, "0"),
      String(parsed.getDate()).padStart(2, "0")
    ].join("-");
  }

  return null;
}

function getMeetingTime(value) {
  if (!value) return "Время не указано";

  const text = String(value);

  const match = text.match(/(\d{1,2}:\d{2})/);

  return match ? match[1] : "Время не указано";
}

function isTerminalStatus(status) {
  return [
    "Приехал на объект",
    "Работает",
    "Отказ",
    "Не приехал",
    "Не прошёл испытательный срок"
  ].includes(String(status || "").trim());
}

function getTodayCandidates() {
  const today = getTodayKey();

  return allCandidates
    .filter(candidate => {
      const meetingDate = parseMeetingDate(candidate.meeting);

      if (meetingDate !== today) return false;
      if (isTerminalStatus(candidate.status)) return false;

      return true;
    })
    .sort((a, b) => {
      return getMeetingTime(a.meeting).localeCompare(
        getMeetingTime(b.meeting)
      );
    });
}

/* =====================================================
   КАЛЕНДАРЬ ВСТРЕЧ
===================================================== */

const CALENDAR_MONTHS = [
  "январь", "февраль", "март", "апрель",
  "май", "июнь", "июль", "август",
  "сентябрь", "октябрь", "ноябрь", "декабрь"
];

const CALENDAR_WEEKDAYS = [
  "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"
];

function dateKey(date) {
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0")
  ].join("-");
}

function parseCalendarKey(key) {
  const parts = key.split("-").map(Number);
  return new Date(parts[0], parts[1] - 1, parts[2]);
}

function addCalendarDays(date, amount) {
  const result = new Date(date);
  result.setDate(result.getDate() + amount);
  return result;
}

function getCalendarMonday(date) {
  const result = new Date(date);
  const day = result.getDay() || 7;
  result.setDate(result.getDate() - day + 1);
  result.setHours(0, 0, 0, 0);
  return result;
}

function formatCalendarPeriod() {
  if (calendarView === "day") {
    return new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"long",
      year:"numeric"
    }).format(calendarDate);
  }

  if (calendarView === "week") {
    const monday = getCalendarMonday(calendarDate);
    const sunday = addCalendarDays(monday, 6);

    const first = new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"short"
    }).format(monday);

    const second = new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"short",
      year:"numeric"
    }).format(sunday);

    return first + " — " + second;
  }

  return CALENDAR_MONTHS[calendarDate.getMonth()] +
    " " + calendarDate.getFullYear();
}

function getCalendarRange() {
  let start;
  let end;

  if (calendarView === "day") {
    start = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth(),
      calendarDate.getDate()
    );

    end = addCalendarDays(start, 1);

  } else if (calendarView === "week") {
    start = getCalendarMonday(calendarDate);
    end = addCalendarDays(start, 7);

  } else {
    start = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth(),
      1
    );

    end = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth() + 1,
      1
    );
  }

  return {
    start:dateKey(start),
    end:dateKey(end)
  };
}

function setCalendarView(view) {
  if (!["month", "week", "day"].includes(view)) return;

  calendarView = view;

  document.querySelectorAll(".calendar-view-btn").forEach(button => {
    button.classList.toggle(
      "active",
      button.dataset.view === view
    );
  });

  loadCalendar();
}

function changeCalendarDate(direction) {
  const next = new Date(calendarDate);

  if (calendarView === "day") {
    next.setDate(next.getDate() + direction);

  } else if (calendarView === "week") {
    next.setDate(next.getDate() + direction * 7);

  } else {
    next.setMonth(next.getMonth() + direction);
  }

  calendarDate = next;
  loadCalendar();
}

function goCalendarToday() {
  calendarDate = new Date();
  loadCalendar();
}

function loadCalendar() {
  if (!document.getElementById("calendarContent")) return;

  const requestNumber = ++calendarRequestNumber;
  const range = getCalendarRange();

  document.getElementById("calendarPeriod").textContent =
    formatCalendarPeriod();

  document.getElementById("calendarContent").innerHTML =
    '<div class="loading">Загружаем встречи...</div>';

  if (isLoadingCalendar) {
    // Предыдущий запрос не отменяем, но его результат будет проигнорирован.
  }

  isLoadingCalendar = true;

  google.script.run
    .withSuccessHandler(result => {
      if (requestNumber !== calendarRequestNumber) return;

      isLoadingCalendar = false;

      if (!result || !result.success) {
        showCalendarError(
          result?.message || "Не удалось загрузить встречи."
        );
        return;
      }

      calendarMeetings = Array.isArray(result.meetings)
        ? result.meetings
        : [];

      renderCalendar();
    })
    .withFailureHandler(error => {
      if (requestNumber !== calendarRequestNumber) return;

      isLoadingCalendar = false;

      showCalendarError(
        error?.message || "Ошибка соединения с сервером."
      );
    })
    .getCalendarMeetings(range.start, range.end);
}

function showCalendarError(message) {
  const content = document.getElementById("calendarContent");

  content.replaceChildren(
    makeText(
      "div",
      "empty",
      "Не удалось загрузить календарь: " + message

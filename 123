function renderCalendarMonth(container) {
  const grid = makeText("div", "calendar-month", "");

  CALENDAR_WEEKDAYS.forEach(day => {
    grid.appendChild(
      makeText("div", "calendar-weekday", day)
    );
  });

  const firstDay = new Date(
    calendarDate.getFullYear(),
    calendarDate.getMonth(),
    1
  );

  const start = getCalendarMonday(firstDay);
  const today = dateKey(new Date());
  const selected = dateKey(calendarDate);

  const grouped = {};

  calendarMeetings.forEach(meeting => {
    if (!grouped[meeting.date]) grouped[meeting.date] = [];
    grouped[meeting.date].push(meeting);
  });

  for (let i = 0; i < 42; i++) {
    const date = addCalendarDays(start, i);
    const key = dateKey(date);

    const classes = ["calendar-day"];

    if (date.getMonth() !== calendarDate.getMonth()) {
      classes.push("other-month");
    }

    if (key === today) classes.push("today");
    if (key === selected) classes.push("selected");

    const cell = makeText("div", classes.join(" "), "");

    cell.appendChild(
      makeText("div", "calendar-day-number", date.getDate())
    );

    const meetings = (grouped[key] || []).slice().sort((a, b) =>
      a.time.localeCompare(b.time)
    );

    meetings.slice(0, 3).forEach(meeting => {
      cell.appendChild(createCalendarEventButton(meeting));
    });

    if (meetings.length > 3) {
      cell.appendChild(
        makeText(
          "div",
          "calendar-more",
          "+" + (meetings.length - 3) + " ещё"
        )
      );
    }

    cell.addEventListener("click", () => {
      calendarDate = date;
      setCalendarView("day");
    });

    grid.appendChild(cell);
  }

  container.appendChild(grid);
}

function renderCalendarWeek(container) {
  const wrapper = makeText("div", "calendar-week-wrapper", "");
  const grid = makeText("div", "calendar-week", "");

  const monday = getCalendarMonday(calendarDate);
  const today = dateKey(new Date());
  const selected = dateKey(calendarDate);

  for (let i = 0; i < 7; i++) {
    const date = addCalendarDays(monday, i);
    const key = dateKey(date);

    const column = makeText("div", "calendar-week-column", "");

    if (key === selected) column.classList.add("selected");

    const dateHeading = makeText("div", "calendar-week-date", "");

    if (key === today) dateHeading.classList.add("today");

    dateHeading.appendChild(
      makeText("strong", "", date.getDate())
    );

    dateHeading.appendChild(
      makeText(
        "span",
        "",
        CALENDAR_WEEKDAYS[i] + " · " +
        CALENDAR_MONTHS[date.getMonth()].slice(0, 3)
      )
    );

    dateHeading.addEventListener("click", () => {
      calendarDate = date;
      setCalendarView("day");
    });

    column.appendChild(dateHeading);

    const meetings = calendarMeetings
      .filter(meeting => meeting.date === key)
      .sort((a, b) => a.time.localeCompare(b.time));

    if (!meetings.length) {
      column.appendChild(
        makeText("div", "calendar-empty-day", "Нет встреч")
      );
    } else {
      meetings.forEach(meeting => {
        column.appendChild(createCalendarEventButton(meeting));
      });
    }

    grid.appendChild(column);
  }

  wrapper.appendChild(grid);
  container.appendChild(wrapper);
}

function renderCalendarDay(container) {
  const layout = makeText("div", "calendar-day-layout", "");

  const heading = makeText(
    "div",
    "calendar-day-heading",
    new Intl.DateTimeFormat("ru-RU", {
      weekday:"long",
      day:"numeric",
      month:"long",
      year:"numeric"
    }).format(calendarDate)
  );

  layout.appendChild(heading);

  const selectedKey = dateKey(calendarDate);

  const meetings = calendarMeetings
    .filter(meeting => meeting.date === selectedKey)
    .sort((a, b) => a.time.localeCompare(b.time));

  if (!meetings.length) {
    layout.appendChild(
      makeText(
        "div",
        "calendar-empty-day",
        "На выбранную дату встреч нет."
      )
    );

    container.appendChild(layout);
    return;
  }

  const grouped = {};

  meetings.forEach(meeting => {
    if (!grouped[meeting.time]) grouped[meeting.time] = [];
    grouped[meeting.time].push(meeting);
  });

  for (let hour = 8; hour <= 19; hour++) {
    for (const minute of [0, 30]) {
      if (hour === 19 && minute === 30) continue;

      const time =
        String(hour).padStart(2, "0") + ":" +
        String(minute).padStart(2, "0");

      const slot = makeText("div", "calendar-slot", "");

      slot.appendChild(
        makeText("div", "calendar-slot-time", time)
      );

      const slotContent = makeText(
        "div",
        "calendar-slot-content",
        ""
      );

      (grouped[time] || []).forEach(meeting => {
        slotContent.appendChild(
          createCalendarEventButton(meeting)
        );
      });

      slot.appendChild(slotContent);
      layout.appendChild(slot);
    }
  }

  container.appendChild(layout);
}


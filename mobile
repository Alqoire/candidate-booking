<!DOCTYPE html>
<html lang="ru">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="theme-color" content="#f5f5f7">
  <title>STROY PODRYAD — Mobile</title>
  <style>
    html, body { touch-action: manipulation; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
    :root{
      --bg:#f5f5f7;--card:#fff;--text:#17181c;--muted:#8a8d96;
      --line:#e7e7eb;--soft:#eeeeF1;--green:#248a5b;--red:#d84b4b;
      --blue:#4779c7;--yellow:#b68119;--nav:78px;--safe:env(safe-area-inset-bottom);
      --r1:26px;--r2:20px;--r3:16px;
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    html,body{margin:0;min-height:100%;background:var(--bg)}
    body{font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Inter,Arial,sans-serif;color:var(--text);font-size:16px;-webkit-font-smoothing:antialiased;padding-bottom:calc(118px + var(--safe) + 24px)}
    button,input,select,textarea{font:inherit}
    button{border:0;cursor:pointer}
    button:active{transform:scale(.985)}
    a{color:inherit}
    .app{width:100%;max-width:760px;margin:auto}
    .screen{display:none;padding:22px 18px 32px}
    .screen.active{display:block}
    .header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:22px;padding-top:4px}
    .eyebrow{color:var(--muted);font-size:13px;font-weight:700;margin-bottom:6px}
    .title{margin:0;font-size:32px;line-height:1.05;font-weight:850;letter-spacing:-.045em}
    .subtitle{margin-top:8px;color:var(--muted);font-size:15px;line-height:1.4}
    .head-btn{width:48px;height:48px;flex:0 0 48px;border:1px solid var(--line);background:#fff;border-radius:16px;display:grid;place-items:center;box-shadow:0 6px 22px rgba(0,0,0,.04)}
    svg.icon{width:22px;height:22px;display:block;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
    .stats{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
    .stat,.card{background:#fff;border:1px solid var(--line);border-radius:var(--r2);box-shadow:0 7px 25px rgba(0,0,0,.035)}
    .stat{min-height:126px;padding:18px}
    .stat-label{color:var(--muted);font-size:14px;font-weight:650}
    .stat-value{margin-top:12px;font-size:38px;line-height:1;font-weight:850;letter-spacing:-.05em}
    .stat-note{margin-top:9px;color:var(--muted);font-size:12px}
    .section{margin-top:22px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:11px}
    .section-title{margin:0;font-size:21px;font-weight:850;letter-spacing:-.025em}
    .link-btn{background:none;color:var(--muted);font-size:14px;font-weight:750;padding:7px 0}
    .list{display:grid;gap:10px}
    .today-card,.candidate-card,.meeting-card,.object-card{background:#fff;border:1px solid var(--line);border-radius:var(--r2);box-shadow:0 7px 25px rgba(0,0,0,.035)}
    .today-card,.candidate-card,.meeting-card{padding:17px}
    .row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
    .name{font-size:18px;line-height:1.2;font-weight:850;letter-spacing:-.025em}
    .minor{margin-top:5px;color:var(--muted);font-size:14px;line-height:1.4}
    .phone-link{display:inline-flex;align-items:center;margin-top:10px;color:#17181c;font-size:17px;font-weight:800;text-decoration:none;padding:7px 10px;margin-left:-10px;border-radius:11px}
    .phone-link:active{background:#f0f0f3}
    .pill{padding:7px 10px;border-radius:999px;background:var(--soft);font-size:12px;font-weight:750;white-space:nowrap}
    .time-pill{padding:8px 10px;border-radius:11px;background:var(--soft);font-size:14px;font-weight:850;white-space:nowrap}
    .meta{display:grid;gap:5px;margin-top:13px;color:var(--muted);font-size:13px;line-height:1.4}
    .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
    .btn{min-height:48px;padding:0 15px;border-radius:15px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:15px;font-weight:800}
    .btn-dark{background:#17181c;color:#fff}.btn-light{background:var(--soft);color:var(--text)}.btn-outline{background:#fff;border:1px solid var(--line)}.btn-danger{background:#fff0f0;color:var(--red)}
    .btn-full{width:100%}
    .search{position:relative;margin-bottom:13px}.search input{width:100%;height:52px;padding:0 16px 0 47px;background:#fff;border:1px solid var(--line);border-radius:17px;font-size:17px}
    .search .icon{position:absolute;left:16px;top:15px;color:var(--muted)}
    .fab{position:fixed;right:18px;bottom:calc(108px + var(--safe) + 18px);z-index:60;width:58px;height:58px;border-radius:20px;background:#17181c;color:#fff;display:grid;place-items:center;box-shadow:0 13px 32px rgba(0,0,0,.2)}
    .fab .icon{width:25px;height:25px}
    .bottom-nav{position:fixed;left:12px;right:12px;bottom:calc(18px + var(--safe));z-index:50;height:76px;padding:5px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));background:rgba(255,255,255,.97);border:1px solid rgba(0,0,0,.07);border-radius:24px;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 14px 40px rgba(0,0,0,.15)}
    .nav-item{width:100%;min-width:0;min-height:64px;background:transparent;color:#8d9098;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;font-size:12px;font-weight:800;border-radius:16px}
    .nav-item .icon{width:29px;height:29px}.nav-item.active{color:#17181c;background:#f0f0f3}.nav-item.active .icon{stroke-width:2.5}
    .form{display:grid;gap:14px}.field{display:grid;gap:7px}.field label{font-size:14px;font-weight:800}
    .field input,.field select,.field textarea{width:100%;min-height:56px;padding:0 15px;border:1px solid var(--line);border-radius:16px;background:#fff;color:var(--text);font-size:16px}
    .field textarea{min-height:110px;padding-top:14px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus,.search input:focus{border-color:#a9abb2;box-shadow:0 0 0 3px rgba(0,0,0,.04);outline:none}
    .form-actions{display:grid;gap:9px;margin-top:5px}
    .empty{padding:30px 20px;text-align:center;color:var(--muted);font-size:15px;line-height:1.45}.empty strong{display:block;color:var(--text);font-size:17px;margin-bottom:5px}
    .loading{padding:30px 20px;text-align:center;color:var(--muted);font-size:14px}.spinner{width:25px;height:25px;margin:0 auto 10px;border:3px solid #e5e5e8;border-top-color:#17181c;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
    .calendar-toolbar{display:grid;grid-template-columns:48px 1fr 48px;gap:8px;align-items:center;margin-bottom:12px}.calendar-toolbar .btn{min-height:48px;padding:0}.calendar-label{text-align:center;font-size:17px;font-weight:850}
    .calendar-switch{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;padding:5px;background:#e9e9ed;border-radius:14px;margin-bottom:14px}.calendar-switch button{height:38px;border-radius:10px;background:transparent;font-size:13px;font-weight:800;color:var(--muted)}.calendar-switch button.active{background:#fff;color:var(--text);box-shadow:0 2px 8px rgba(0,0,0,.06)}
    .month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}.weekday{text-align:center;color:var(--muted);font-size:11px;font-weight:800;padding:5px 0}.day{min-height:50px;border:1px solid var(--line);border-radius:12px;background:#fff;padding:7px;font-size:13px;font-weight:750;text-align:left}.day.muted{color:#b8bac1;background:#fafafa}.day.today{box-shadow:inset 0 0 0 2px #17181c}.day.selected{background:#17181c;color:#fff}.day .dot{width:6px;height:6px;border-radius:50%;background:currentColor;margin-top:6px;opacity:.7}
    .agenda{display:grid;gap:9px}.agenda-item{display:grid;grid-template-columns:62px 1fr;gap:12px;padding:14px;background:#fff;border:1px solid var(--line);border-radius:17px}.agenda-time{font-size:18px;font-weight:850}.agenda-body{min-width:0}.agenda-name{font-size:16px;font-weight:800}.agenda-meta{margin-top:4px;color:var(--muted);font-size:13px}
    .object-list{display:grid;gap:9px}.object-card{padding:17px;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:space-between}
    .analytics-grid{display:grid;gap:12px}.analytics-card{padding:18px;background:#fff;border:1px solid var(--line);border-radius:20px}.analytics-number{font-size:32px;font-weight:850;margin-top:7px}.analytics-label{color:var(--muted);font-size:13px;font-weight:700}
    .reschedule-time-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:4px}.time-choice{min-height:52px;border:1px solid var(--line);border-radius:15px;background:#fff;font-size:16px;font-weight:800;color:var(--text)}.time-choice.active{background:#17181c;color:#fff;border-color:#17181c}.reschedule-time-note{font-size:13px;color:var(--muted);margin-top:7px}.reschedule-actions{display:grid;gap:10px;margin-top:6px}@media(min-width:700px){.reschedule-time-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
    .modal{position:fixed;inset:0;z-index:100;display:none;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.36);padding:0}.modal.open{display:flex}.sheet{width:100%;max-width:760px;max-height:93vh;overflow:auto;background:#fff;border-radius:28px 28px 0 0;padding:11px 18px calc(24px + var(--safe));box-shadow:0 -20px 60px rgba(0,0,0,.18)}.handle{width:38px;height:5px;margin:0 auto 20px;border-radius:99px;background:#d7d7dc}.sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px}.sheet-title{margin:0;font-size:25px;font-weight:850;letter-spacing:-.035em}.close{width:40px;height:40px;border-radius:13px;background:var(--soft);display:grid;place-items:center}.close .icon{width:20px;height:20px}
    .toast{position:fixed;left:16px;right:16px;top:calc(13px + env(safe-area-inset-top));z-index:200;padding:15px 17px;border-radius:17px;background:#17181c;color:#fff;font-size:14px;font-weight:700;line-height:1.4;box-shadow:0 14px 40px rgba(0,0,0,.2);transform:translateY(-140%);opacity:0;transition:.25s}.toast.show{transform:translateY(0);opacity:1}.toast.error{background:#9f3030}.toast.success{background:#176d49}
    .profile-block{display:grid;gap:14px}.profile-card{padding:18px}.profile-label{color:var(--muted);font-size:12px;margin-bottom:4px}.profile-value{font-size:16px;font-weight:750}
    .history-item{padding:15px 17px;border-bottom:1px solid var(--line)}.history-item:last-child{border-bottom:0}.history-action{font-size:14px;font-weight:800}.history-text{margin-top:5px;color:var(--muted);font-size:12px;line-height:1.45}.history-date{margin-top:5px;color:var(--muted);font-size:11px}
    @media(min-width:701px){.app{max-width:760px}.bottom-nav{left:50%;right:auto;width:min(620px,calc(100vw - 24px));transform:translateX(-50%);border-radius:24px}.fab{right:max(18px,calc((100vw - 760px)/2 + 18px))}}
    @media(max-width:380px){.screen{padding-left:14px;padding-right:14px}.title{font-size:29px}.stat{padding:15px}.stat-value{font-size:34px}}
    @media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
<div class="app">

  <section class="screen active" id="screen-today">
    <header class="header">
      <div>
        <div class="eyebrow">Сегодня</div>
        <h1 class="title">Добрый день</h1>
        <div class="subtitle" id="todayDate"></div>
      </div>
      <button class="head-btn" onclick="refreshAll()" aria-label="Обновить">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14.9-4M4 5v5h5"/><path d="M4 13a8 8 0 0 0 14.9 4M20 19v-5h-5"/></svg>
      </button>
    </header>

    <div class="stats">
      <div class="stat"><div class="stat-label">Кандидаты</div><div class="stat-value" id="statCandidates">—</div><div class="stat-note">в базе</div></div>
      <div class="stat"><div class="stat-label">Сегодня</div><div class="stat-value" id="statToday">—</div><div class="stat-note">кандидатов</div></div>
      <div class="stat"><div class="stat-label">Новые</div><div class="stat-value" id="statNew">—</div><div class="stat-note">кандидаты</div></div>
      <div class="stat"><div class="stat-label">В работе</div><div class="stat-value" id="statWorking">—</div><div class="stat-note">кандидаты</div></div>
    </div>

    <section class="section">
      <div class="section-head"><h2 class="section-title">Встречи сегодня</h2><button class="link-btn" onclick="openScreen('calendar')">Все</button></div>
      <div id="todayMeetings" class="list"><div class="loading"><div class="spinner"></div>Загружаем встречи</div></div>
    </section>


  </section>

  <section class="screen" id="screen-candidates">
    <header class="header">
      <div><div class="eyebrow">CRM</div><h1 class="title">Кандидаты</h1><div class="subtitle">Все кандидаты</div></div>
      <button class="head-btn" onclick="openAddCandidate()" aria-label="Добавить кандидата">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </header>
    <div class="search"><svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input id="candidateSearch" type="search" placeholder="Имя, телефон, специальность" oninput="renderCandidates()"></div>
    <div id="candidatesList" class="list"><div class="loading"><div class="spinner"></div>Загружаем кандидатов</div></div>
  </section>

  <section class="screen" id="screen-calendar">
    <header class="header">
      <div><div class="eyebrow">Расписание</div><h1 class="title">Календарь</h1><div class="subtitle">Встречи и собеседования</div></div>
      <button class="head-btn" onclick="loadCalendar(true)" aria-label="Обновить">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14.9-4M4 5v5h5"/><path d="M4 13a8 8 0 0 0 14.9 4M20 19v-5h-5"/></svg>
      </button>
    </header>
    <div class="calendar-switch">
      <button id="viewDay" onclick="setCalendarView('day')">День</button>
      <button id="viewWeek" onclick="setCalendarView('week')">Неделя</button>
      <button id="viewMonth" onclick="setCalendarView('month')">Месяц</button>
    </div>
    <div class="calendar-toolbar">
      <button class="btn btn-light" onclick="moveCalendar(-1)">‹</button>
      <div class="calendar-label" id="calendarLabel"></div>
      <button class="btn btn-light" onclick="moveCalendar(1)">›</button>
    </div>
    <div id="calendarContent"></div>
  </section>

  <section class="screen" id="screen-objects">
    <header class="header">
      <div><div class="eyebrow">Справочник</div><h1 class="title">Объекты</h1><div class="subtitle">Объекты для кандидатов</div></div>
      <button class="head-btn" onclick="openAddObject()" aria-label="Добавить объект">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      </button>
    </header>
    <div id="objectsList" class="object-list"><div class="loading"><div class="spinner"></div>Загружаем объекты</div></div>
  </section>

  <section class="screen" id="screen-analytics">
    <header class="header">
      <div><div class="eyebrow">Отчёт</div><h1 class="title">Аналитика</h1><div class="subtitle">Подбор персонала</div></div>
      <button class="head-btn" onclick="loadAnalytics()" aria-label="Обновить">
        <svg class="icon" viewBox="0 0 24 24"><path d="M4 19V5M4 19h16"/><path d="M8 16v-5M12 16V7M16 16v-9"/></svg>
      </button>
    </header>
    <div id="analyticsContent" class="analytics-grid"><div class="loading"><div class="spinner"></div>Загружаем аналитику</div></div>
  </section>
</div>

<button class="fab" id="fab" onclick="openAddCandidate()" aria-label="Добавить кандидата">
  <svg class="icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
</button>

<nav class="bottom-nav">
  <button class="nav-item active" data-screen="today" onclick="openScreen('today')"><svg class="icon" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-7h6v7"/></svg><span>Сегодня</span></button>
  <button class="nav-item" data-screen="candidates" onclick="openScreen('candidates')"><svg class="icon" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 11a3 3 0 1 0 0-6M18 14a5 5 0 0 1 3 4"/></svg><span>Кандидаты</span></button>
  <button class="nav-item" data-screen="calendar" onclick="openScreen('calendar')"><svg class="icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M8 2v4M16 2v4M3 9h18"/></svg><span>Календарь</span></button>
  <button class="nav-item" data-screen="objects" onclick="openScreen('objects')"><svg class="icon" viewBox="0 0 24 24"><path d="M3 21V8l9-5 9 5v13"/><path d="M3 10h18M8 21v-6h8v6"/></svg><span>Объекты</span></button>
  <button class="nav-item" data-screen="analytics" onclick="openScreen('analytics')"><svg class="icon" viewBox="0 0 24 24"><path d="M4 20V4M4 20h16"/><path d="M8 16v-5M12 16V7M16 16v-9"/></svg><span>Аналитика</span></button>
</nav>

<div class="modal" id="candidateModal" onclick="backdropClose(event,'candidateModal')">
  <div class="sheet">
    <div class="handle"></div>
    <div class="sheet-head"><h2 class="sheet-title">Новый кандидат</h2><button class="close" onclick="closeModal('candidateModal')"><svg class="icon" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form class="form" id="candidateForm" onsubmit="createCandidateFromForm(event)">
      <div class="field"><label>Имя</label><input id="newName" required autocomplete="name"></div>
      <div class="field"><label>Телефон</label><input id="newPhone" required type="tel" autocomplete="tel"></div>
      <div class="field"><label>Специальность</label><input id="newSpecialty" required></div>
      <div class="field"><label>Объект</label><select id="newObject"><option value="">Выберите объект</option></select></div>
      <div class="field"><label>Дата встречи</label><input id="newDate" required type="date"></div>
      <div class="field"><label>Время встречи</label><input id="newTime" required type="time" value="10:00"></div>
      <div class="field"><label>Комментарий</label><textarea id="newComment" placeholder="Необязательно"></textarea></div>
      <div class="form-actions"><button class="btn btn-dark btn-full" type="submit">Добавить кандидата</button><button class="btn btn-light btn-full" type="button" onclick="closeModal('candidateModal')">Отмена</button></div>
    </form>
  </div>
</div>

<div class="modal" id="profileModal" onclick="backdropClose(event,'profileModal')">
  <div class="sheet">
    <div class="handle"></div>
    <div class="sheet-head"><h2 class="sheet-title" id="profileName">Кандидат</h2><button class="close" onclick="closeModal('profileModal')"><svg class="icon" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <div id="profileContent"><div class="loading"><div class="spinner"></div>Загружаем профиль</div></div>
  </div>
</div>

<div class="modal" id="objectModal" onclick="backdropClose(event,'objectModal')">
  <div class="sheet">
    <div class="handle"></div>
    <div class="sheet-head"><h2 class="sheet-title">Новый объект</h2><button class="close" onclick="closeModal('objectModal')"><svg class="icon" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <form class="form" onsubmit="createObject(event)">
      <div class="field"><label>Название объекта</label><input id="objectName" required></div>
      <div class="form-actions"><button class="btn btn-dark btn-full" type="submit">Добавить объект</button><button class="btn btn-light btn-full" type="button" onclick="closeModal('objectModal')">Отмена</button></div>
    </form>
  </div>
</div>

<div class="modal" id="meetingModal" onclick="backdropClose(event,'meetingModal')">
  <div class="sheet">
    <div class="handle"></div>
    <div class="sheet-head"><h2 class="sheet-title">Встреча</h2><button class="close" onclick="closeModal('meetingModal')"><svg class="icon" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <div id="meetingContent"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
'use strict';

const state = {
  screen:'today',
  candidates:[],
  todayCandidates:[],
  meetings:[],
  objects:[],
  calendarDate:new Date(),
  calendarView:'day',
  calendarRequest:0,
  candidateId:null
};

const $ = id => document.getElementById(id);

function serverCall(method,...args){
  return new Promise((resolve,reject)=>{
    if(!window.google || !google.script || !google.script.run){
      reject(new Error('google.script.run недоступен. Откройте приложение через Web App Apps Script.'));
      return;
    }
    let runner=google.script.run
      .withSuccessHandler(resolve)
      .withFailureHandler(err=>reject(new Error(err && err.message ? err.message : String(err))));
    try{ runner[method](...args); }
    catch(e){ reject(e); }
  });
}

function showToast(message,type=''){
  const el=$('toast'); if(!el)return;
  el.textContent=message; el.className='toast show '+type;
  clearTimeout(showToast.t); showToast.t=setTimeout(()=>el.className='toast',3500);
}

function escapeHtml(v){
  return String(v ?? '').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}
function pad(n){return String(n).padStart(2,'0')}
function ymd(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}
function todayYmd(){return ymd(new Date())}
function addDays(d,n){const x=new Date(d);x.setDate(x.getDate()+n);return x}
function formatDate(v){
  if(!v)return '';
  const s=String(v);
  const m=s.match(/(\d{4})-(\d{2})-(\d{2})/);
  if(m)return `${m[3]}.${m[2]}.${m[1]}`;
  const d=new Date(v); return isNaN(d)?s:d.toLocaleDateString('ru-RU');
}
function formatTime(v){
  if(!v)return '';
  const s=String(v);
  const m=s.match(/(?:T|\s)(\d{2}):(\d{2})/);
  if(m)return m[1]+':'+m[2];
  const t=s.match(/^(\d{1,2}):(\d{2})/); if(t)return pad(t[1])+':'+t[2];
  return s;
}
function monthName(d){return d.toLocaleDateString('ru-RU',{month:'long',year:'numeric'})}
function dayLabel(d){return d.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'})}
function normalizeDate(v){
  if(!v)return '';
  const s=String(v);
  const m=s.match(/(\d{4})-(\d{2})-(\d{2})/);
  return m?`${m[1]}-${m[2]}-${m[3]}`:'';
}
function candidateDate(c){return normalizeDate(c.added || c.createdAt || c.date || c.created || '')}
function meetingDate(m){return normalizeDate(m.date || m.startDate || m.start || m.datetime || '')}
function meetingTime(m){return formatTime(m.time || m.startTime || m.start || m.datetime || '')}
function meetingName(m){return m.name || m.candidateName || m.title || 'Кандидат'}
function meetingObject(m){return m.object || m.objectName || ''}
function meetingId(m){return m.meetingId || m.id || ''}
function candidateId(c){return c.candidateId || c.id || ''}


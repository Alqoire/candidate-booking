function rescheduleMeetingMobile(id){
  const times=[];
  for(let h=8;h<=20;h++){
    for(const m of [0,30]){
      if(h===20 && m===30) continue;
      times.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`);
    }
  }
  const current=todayYmd();
  $('meetingContent').innerHTML=`
    <div class="form">
      <div class="field"><label>Новая дата</label><input id="rescheduleDate" type="date" value="${current}"></div>
      <div class="field">
        <label>Время встречи</label>
        <div class="reschedule-time-grid" id="rescheduleTimeGrid">
          ${times.map(t=>`<button type="button" class="time-choice${t==='10:00'?' active':''}" onclick="selectRescheduleTime('${t}')">${t}</button>`).join('')}
        </div>
        <div class="reschedule-time-note">Выбери время одним нажатием</div>
        <input id="rescheduleTime" type="hidden" value="10:00">
      </div>
      <div class="field"><label>Причина переноса</label><textarea id="rescheduleReason" placeholder="Например: кандидат попросил перенести"></textarea></div>
      <div class="reschedule-actions">
        <button class="btn btn-dark btn-full" type="button" onclick="submitReschedule('${escapeHtml(id)}')">Перенести встречу</button>
        <button class="btn btn-light btn-full" type="button" onclick="closeModal('meetingModal')">Отмена</button>
      </div>
    </div>`;
  openModal('meetingModal');
}

function selectRescheduleTime(time){
  const input=$('rescheduleTime');
  if(input) input.value=time;
  document.querySelectorAll('#rescheduleTimeGrid .time-choice').forEach(btn=>btn.classList.toggle('active',btn.textContent.trim()===time));
}

async function submitReschedule(id){
  const date=$('rescheduleDate')?.value;
  const time=$('rescheduleTime')?.value;
  const reason=$('rescheduleReason')?.value.trim()||'';
  if(!date){showToast('Выбери дату','error');return;}
  if(!time){showToast('Выбери время','error');return;}
  try{
    const r=await serverCall('rescheduleMeeting',id,date,time,reason);
    if(!r || r.success===false)throw new Error(r?.error||'Не удалось перенести встречу');
    closeModal('meetingModal');
    showToast('Встреча перенесена','success');
    await refreshAll();
  }catch(e){showToast(e.message||'Ошибка','error')}
}

async function cancelMeetingMobile(id){
  if(!confirm('Отменить эту встречу?'))return;
  const reason=prompt('Причина отмены:','');
  try{
    const r=await serverCall('cancelMeeting',id,reason||'');
    if(!r || r.success===false)throw new Error(r?.error||'Не удалось отменить встречу');
    closeModal('meetingModal'); showToast('Встреча отменена','success'); await refreshAll();
  }catch(e){showToast(e.message||'Ошибка','error')}
}


      stats.total ?? stats.count ?? state.candidates.length;
    $('statToday').textContent =
      stats.today ?? stats.todayCount ?? 0;
    $('statNew').textContent =
      stats.newCount ?? stats.new ?? 0;
    $('statWorking').textContent =
      stats.started ?? stats.working ?? 0;

    renderCandidates();
  }catch(e){
    console.error('getCandidates:',e);

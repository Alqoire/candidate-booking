function moveCalendar(n){
  if(state.calendarView==='day')state.calendarDate=addDays(state.calendarDate,n);
  else if(state.calendarView==='week')state.calendarDate=addDays(state.calendarDate,n*7);
  else {const d=new Date(state.calendarDate);state.calendarDate=new Date(d.getFullYear(),d.getMonth()+n,1);}
  loadCalendar();
}

function renderCalendar(){
  renderCalendarHeader();
  const box=$('calendarContent');
  if(state.calendarView==='day'){
    const ds=ymd(state.calendarDate), list=state.meetings.filter(m=>meetingDate(m)===ds).sort((a,b)=>meetingTime(a).localeCompare(meetingTime(b)));
    box.innerHTML=list.length?`<div class="agenda">${list.map(renderAgenda).join('')}</div>`:emptyHtml('Встреч нет','На выбранный день ничего не запланировано.');
    return;
  }
  if(state.calendarView==='week'){
    const d=new Date(state.calendarDate), day=(d.getDay()+6)%7, start=addDays(d,-day);
    let html='<div class="agenda">';
    for(let i=0;i<7;i++){const x=addDays(start,i), ds=ymd(x), list=state.meetings.filter(m=>meetingDate(m)===ds).sort((a,b)=>meetingTime(a).localeCompare(meetingTime(b)));html+=`<div><div style="font-size:14px;font-weight:850;margin:10px 2px">${escapeHtml(x.toLocaleDateString('ru-RU',{weekday:'short',day:'numeric',month:'short'}))}</div>${list.length?list.map(renderAgenda).join(''):'<div class="card empty" style="padding:16px">Нет встреч</div>'}</div>`}
    box.innerHTML=html+'</div>'; return;
  }
  renderMonth(box);
}

function renderMonth(box){
  const d=state.calendarDate, first=new Date(d.getFullYear(),d.getMonth(),1), days=new Date(d.getFullYear(),d.getMonth()+1,0).getDate(), offset=(first.getDay()+6)%7;
  const meetDays=new Set(state.meetings.map(meetingDate));
  let html='<div class="month-grid">'+['Пн','Вт','Ср','Чт','Пт','Сб','Вс'].map(x=>`<div class="weekday">${x}</div>`).join('');
  for(let i=0;i<offset;i++)html+='<div></div>';
  for(let n=1;n<=days;n++){const x=new Date(d.getFullYear(),d.getMonth(),n),ds=ymd(x),today=ds===todayYmd(),sel=ds===ymd(state.calendarDate);html+=`<button class="day ${today?'today ':''}${sel?'selected':''}" onclick="selectCalendarDay('${ds}')">${n}${meetDays.has(ds)?'<div class="dot"></div>':''}</button>`}
  box.innerHTML=html+'</div>';
}

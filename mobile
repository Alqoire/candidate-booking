async function loadCandidates(){
  setLoading('candidatesList','Загружаем кандидатов');
  try{
    const r=await serverCall('getCandidates');

    // Совместимость с текущим Code.gs: обычно {success,candidates,stats},
    // но не ломаемся, если backend вернул массив/данные в другом контейнере.
    if(r && r.success===false){
      throw new Error(r.error || r.message || 'Не удалось получить кандидатов');
    }

    const list =
      Array.isArray(r) ? r :
      Array.isArray(r?.candidates) ? r.candidates :
      Array.isArray(r?.data) ? r.data :
      Array.isArray(r?.result) ? r.result : [];

    state.candidates=list;


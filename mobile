    const r=await Promise.race([
      serverCall('getObjects'),
      new Promise((_,reject)=>setTimeout(()=>reject(new Error('timeout')),5000))
    ]);
    state.objects=Array.isArray(r?.objects)?r.objects:(Array.isArray(r)?r:[]);
    select.innerHTML='<option value="">Выберите объект</option>';
    state.objects.forEach(o=>{
      const v=typeof o==='string'?o:(o.name||o.objectName||o.title||'');
      if(v){const opt=document.createElement('option');opt.value=v;opt.textContent=v;select.appendChild(opt)}
    });
  }catch(e){
    select.innerHTML='<option value="">Объект недоступен — можно продолжить</option>';
  }
}

async function createCandidateFromForm(e){
  e.preventDefault(); const submit=e.submitter;if(submit){submit.disabled=true;submit.textContent='Сохраняем...'}
  const data={name:$('newName').value.trim(),phone:$('newPhone').value.trim(),specialty:$('newSpecialty').value.trim(),object:$('newObject').value,date:$('newDate').value,time:$('newTime').value,comment:$('newComment').value.trim()};
  try{
    const r=await serverCall('createCandidate',data);
    if(!r || r.success===false)throw new Error(r?.error||'Не удалось создать кандидата');
    closeModal('candidateModal');showToast('Кандидат сохранён, встреча создана','success');await refreshAll();
  }catch(e){showToast(e.message||'Ошибка при создании кандидата','error')}
  finally{if(submit){submit.disabled=false;submit.textContent='Добавить кандидата'}}
}

async function loadObjects(){
  setLoading('objectsList','Загружаем объекты');
  try{
    const r=await serverCall('getObjects');state.objects=Array.isArray(r?.objects)?r.objects:(Array.isArray(r)?r:[]);
    $('objectsList').innerHTML=state.objects.length?state.objects.map(o=>{const v=typeof o==='string'?o:(o.name||o.objectName||o.title||'');return `<div class="object-card">${escapeHtml(v)}<span style="color:var(--muted)">›</span></div>`}).join(''):emptyHtml('Объектов нет','Добавьте первый объект.');
  }catch(e){$('objectsList').innerHTML=emptyHtml('Ошибка загрузки',e.message)}
}
function openAddObject(){$('objectName').value='';openModal('objectModal')}
async function createObject(e){
  e.preventDefault();const name=$('objectName').value.trim();if(!name)return;
  try{const r=await serverCall('addObject',name);if(!r || r.success===false)throw new Error(r?.error||'Не удалось добавить объект');closeModal('objectModal');showToast('Объект добавлен','success');loadObjects()}catch(err){showToast(err.message||'Ошибка','error')}
}

async function loadAnalytics(){
  $('analyticsContent').innerHTML='<div class="loading"><div class="spinner"></div>Загружаем аналитику</div>';
  try{
    const r=await serverCall('getRecruitmentAnalytics',{period:'month'});
    if(!r || r.success===false)throw new Error(r?.error||'Не удалось получить аналитику');
    const data=r.analytics||r.data||r;
    const entries=Object.entries(data).filter(([k,v])=>typeof v==='number' || typeof v==='string');
    $('analyticsContent').innerHTML=entries.length?entries.slice(0,12).map(([k,v])=>`<div class="analytics-card"><div class="analytics-label">${escapeHtml(prettyKey(k))}</div><div class="analytics-number">${escapeHtml(v)}</div></div>`).join(''):emptyHtml('Нет данных','Аналитика пока не вернула показатели.');
  }catch(e){$('analyticsContent').innerHTML=emptyHtml('Ошибка загрузки',e.message)}
}
function prettyKey(k){return String(k).replace(/([A-Z])/g,' $1').replace(/^./,x=>x.toUpperCase()).replace(/_/g,' ')}

async function refreshAll(){
  $('todayDate').textContent=new Date().toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'});
  await Promise.allSettled([loadCandidates(),loadTodayMeetings()]);
  if(state.screen==='calendar')loadCalendar(true);
}

function emptyHtml(title,text){return `<div class="card empty"><strong>${escapeHtml(title)}</strong>${escapeHtml(text||'')}</div>`}

document.addEventListener('DOMContentLoaded',()=>{
  $('fab').style.display='none';
  $('todayDate').textContent=new Date().toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long'});
  refreshAll();
});
</script>

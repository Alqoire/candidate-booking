function renderCalendarHeader(){
  let label='';
  if(state.calendarView==='day')label=dayLabel(state.calendarDate);
  else if(state.calendarView==='week'){const d=new Date(state.calendarDate);const day=(d.getDay()+6)%7;const s=addDays(d,-day),e=addDays(s,6);label=s.getMonth()===e.getMonth()?`${s.getDate()}–${e.getDate()} ${s.toLocaleDateString('ru-RU',{month:'long'})}`:`${formatDate(ymd(s))}–${formatDate(ymd(e))}`;}
  else label=monthName(state.calendarDate);

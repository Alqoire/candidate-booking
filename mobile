function getCalendarRange(){
  const d=new Date(state.calendarDate);
  if(state.calendarView==='day')return {start:ymd(d),end:ymd(addDays(d,1))};
  if(state.calendarView==='week'){
    const x=new Date(d); const day=(x.getDay()+6)%7; x.setDate(x.getDate()-day);
    return {start:ymd(x),end:ymd(addDays(x,7))};
  }
  const start=new Date(d.getFullYear(),d.getMonth(),1), end=new Date(d.getFullYear(),d.getMonth()+1,1);
  return {start:ymd(start),end:ymd(end)};
}


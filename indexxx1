<div id="toast" class="toast"></div>
<script>
/* =========================================================
   STROY PODRYAD — MOBILE
   Работаем с существующим Code.gs
========================================================= */

let candidates = [];
let todayCandidates = [];
let todayMeetings = [];
let meetings = [];
let objects = [];

let currentMeetingDate = new Date();
let currentCandidateId = null;


/* =========================================================
   УТИЛИТЫ
========================================================= */

function $(id) {
  return document.getElementById(id);
}


function escapeHtml(value) {
  if (value === null || value === undefined) return "";

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


function formatDateRu(date) {
  if (!(date instanceof Date) || isNaN(date)) {
    return "";
  }

  return date.toLocaleDateString("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric"
  });
}


function formatShortDate(value) {
  if (!value) return "";

  const d = parseDate(value);

  if (!d) return String(value);

  return d.toLocaleDateString("ru-RU", {
    day: "numeric",
    month: "long"
  });
}


function formatTime(value) {
  if (!value) return "";

  const s = String(value);

  const match = s.match(/(\d{1,2}):(\d{2})/);

  if (match) {
    return (
      String(match[1]).padStart(2, "0") +
      ":" +
      match[2]
    );
  }

  return s;
}


function dateToYmd(date) {
  const y = date.getFullYear();

  const m = String(
    date.getMonth() + 1
  ).padStart(2, "0");

  const d = String(
    date.getDate()
  ).padStart(2, "0");

  return `${y}-${m}-${d}`;
}


function parseDate(value) {
  if (!value) return null;

  if (value instanceof Date) {
    return isNaN(value) ? null : value;
  }

  const s = String(value);

  let match = s.match(
    /^(\d{4})-(\d{2})-(\d{2})/
  );

  if (match) {
    const d = new Date(
      Number(match[1]),
      Number(match[2]) - 1,
      Number(match[3])
    );

    return isNaN(d) ? null : d;
  }

  const parsed = new Date(value);

  return isNaN(parsed) ? null : parsed;
}


function getTodayYmd() {
  return dateToYmd(new Date());
}


function showToast(message, type = "info") {
  const toast = $("toast");

  if (!toast) return;

  toast.textContent = message;

  toast.style.background =
    type === "error"
      ? "#b52f2f"
      : type === "success"
        ? "#23794f"
        : "#17181c";

  toast.classList.add("show");

  clearTimeout(showToast.timer);

  showToast.timer = setTimeout(() => {
    toast.classList.remove("show");
  }, 3000);
}


function setLoading(elementId, text = "Загрузка") {
  const el = $(elementId);

  if (!el) return;

  el.innerHTML = `
    <div class="loading">
      <div class="spinner"></div>
      ${escapeHtml(text)}
    </div>
  `;
}


function showComingSoon(name) {
  showToast(
    `${name}: раздел будет подключён к основной CRM.`,
    "info"
  );
}


/* =========================================================
   GOOGLE APPS SCRIPT
========================================================= */

function serverCall(method, ...args) {
  return new Promise((resolve, reject) => {

    if (
      typeof google === "undefined" ||
      !google.script ||
      !google.script.run
    ) {
      reject(
        new Error(
          "Приложение открыто не из Google Apps Script."
        )
      );
      return;
    }

    const runner =
      google.script.run
        .withSuccessHandler(resolve)
        .withFailureHandler(error => {
          reject(error);
        });

    if (
      !runner ||
      typeof runner[method] !== "function"
    ) {
      reject(
        new Error(
          `Метод ${method} не найден в Code.gs`
        )
      );
      return;
    }

    runner[method](...args);
  });
}


/* =========================================================
   НАВИГАЦИЯ
========================================================= */

function openScreen(screenName) {

  document
    .querySelectorAll(".screen")
    .forEach(screen => {
      screen.classList.remove("active");
    });

  const target = $(
    "screen-" + screenName
  );

  if (!target) return;

  target.classList.add("active");


  document
    .querySelectorAll(".nav-item")
    .forEach(item => {

      item.classList.toggle(
        "active",
        item.dataset.screen === screenName
      );

    });


  const fab = $("candidateFab");

  if (fab) {
    fab.style.display =
      screenName === "candidates"
        ? "grid"
        : "none";
  }


  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });


  if (screenName === "today") {
    loadToday();
  }

  if (screenName === "candidates") {
    loadCandidates();
  }

  if (screenName === "meetings") {
    loadMeetings();
  }

  if (screenName === "objects") {
    loadObjects();
  }
}


/* =========================================================
   TODAY
========================================================= */

function updateTodayHeader() {

  const now = new Date();

  const dateEl = $("todayDate");

  if (dateEl) {
    dateEl.textContent =
      formatDateRu(now);
  }
}


async function loadToday() {

  updateTodayHeader();

  setLoading(
    "todayMeetings",
    "Загружаем встречи"
  );

  setLoading(
    "todayCandidates",
    "Загружаем кандидатов"
  );


  try {

    /*
      ВАЖНО:

      getCalendarMeetings в Code.gs
      принимает ДВЕ даты.

      Поэтому передаём startDate и endDate.
    */

    const today = getTodayYmd();

    const calendarResult =
      await serverCall(
        "getCalendarMeetings",
        today,
        today
      );


    if (
      calendarResult &&
      calendarResult.success
    ) {

      todayMeetings =
        Array.isArray(
          calendarResult.meetings
        )
          ? calendarResult.meetings
          : [];

    } else {

      todayMeetings = [];

    }


    /*
      Кандидаты берём из getCandidates(),
      а не придумываем собственную
      структуру данных.
    */

    const candidatesResult =
      await serverCall(
        "getCandidates"
      );


    if (
      candidatesResult &&
      candidatesResult.success
    ) {

      candidates =
        Array.isArray(
          candidatesResult.candidates
        )
          ? candidatesResult.candidates
          : [];


      const stats =
        candidatesResult.stats || {};


      $("statCandidates").textContent =
        stats.total ?? candidates.length;

      $("statToday").textContent =
        stats.today ?? 0;

      $("statNew").textContent =
        stats.newCount ?? 0;

      $("statWorking").textContent =
        stats.started ?? 0;


      /*
        Если backend уже подготовил
        todayCount — используем его.

        Иначе дополнительно фильтруем
        по дате встречи/добавления.
      */

      todayCandidates =
        candidates.filter(candidate => {

          const meetingDate =
            candidate.meeting ||
            candidate.meetingDate ||
            candidate.date ||
            "";

          if (!meetingDate) return false;

          return (
            String(meetingDate)
              .slice(0, 10) === today
          );

        });

    } else {

      candidates = [];
      todayCandidates = [];

      $("statCandidates").textContent = "0";
      $("statToday").textContent = "0";
      $("statNew").textContent = "0";
      $("statWorking").textContent = "0";
    }


    renderTodayMeetings();
    renderTodayCandidates();


  } catch (error) {

    console.error(
      "loadToday:",
      error
    );

    $("todayMeetings").innerHTML = `
      <div class="empty">
        <strong>Не удалось загрузить встречи</strong>
        ${escapeHtml(
          error && error.message
            ? error.message
            : "Ошибка сервера"
        )}
      </div>
    `;


    $("todayCandidates").innerHTML = `
      <div class="empty">
        <strong>Не удалось загрузить кандидатов</strong>
        Попробуйте обновить страницу.
      </div>
    `;

    showToast(
      "Не удалось загрузить данные",
      "error"
    );
  }
}


/* =========================================================
   TODAY MEETINGS
========================================================= */

function renderTodayMeetings() {

  const container =
    $("todayMeetings");

  if (!container) return;


  if (!todayMeetings.length) {

    container.innerHTML = `
      <div class="card empty">
        <strong>Сегодня встреч нет</strong>
        Свободный день
      </div>
    `;

    return;
  }


  container.innerHTML =
    todayMeetings
      .map(meeting => {

        const name =
          meeting.name ||
          meeting.candidateName ||
          meeting.title ||
          "Кандидат";


        const specialty =
          meeting.specialty ||
          meeting.position ||
          "";


        const time =
          formatTime(
            meeting.time ||
            meeting.startTime ||
            meeting.start
          );


        const object =
          meeting.object ||
          meeting.objectName ||
          "";


        const meetingId =
          meeting.meetingId ||
          meeting.id ||
          "";


        return `
          <button
            class="today-card"
            onclick="openMeetingActions('${escapeHtml(meetingId)}')">

            <div class="today-top">

              <div>

                <div class="today-name">
                  ${escapeHtml(name)}
                </div>

                ${
                  specialty
                    ? `
                      <div class="today-specialty">
                        ${escapeHtml(specialty)}
                      </div>
                    `
                    : ""
                }

              </div>


              ${
                time
                  ? `
                    <div class="today-time">
                      ${escapeHtml(time)}
                    </div>
                  `
                  : ""
              }

            </div>


            <div class="today-meta">

              ${
                object
                  ? `
                    <div>
                      ${escapeHtml(object)}
                    </div>
                  `
                  : ""
              }

              ${
                meetingId
                  ? `
                    <div>
                      Встреча
                    </div>
                  `
                  : ""
              }

            </div>

          </button>
        `;

      })
      .join("");
}


/* =========================================================
   TODAY CANDIDATES
========================================================= */

function renderTodayCandidates() {

  const container =
    $("todayCandidates");

  if (!container) return;


  if (!todayCandidates.length) {

    container.innerHTML = `
      <div class="card empty">
        <strong>Сегодня кандидатов нет</strong>
        Новых кандидатов за сегодня нет
      </div>
    `;

    return;
  }


  container.innerHTML =
    todayCandidates
      .map(renderCandidateCard)
      .join("");
}


/* =========================================================
   CANDIDATES
========================================================= */

async function loadCandidates() {

  setLoading(
    "candidatesList",
    "Загружаем кандидатов"
  );


  try {

    const result =
      await serverCall(
        "getCandidates"
      );


    if (
      !result ||
      !result.success
    ) {
      throw new Error(
        result && result.error
          ? result.error
          : "Не удалось получить кандидатов"
      );
    }


    candidates =
      Array.isArray(result.candidates)
        ? result.candidates
        : [];


    const stats =
      result.stats || {};


    $("statCandidates").textContent =
      stats.total ?? candidates.length;

    $("statToday").textContent =
      stats.today ?? 0;

    $("statNew").textContent =
      stats.newCount ?? 0;

    $("statWorking").textContent =
      stats.started ?? 0;


    renderCandidates();


  } catch (error) {

    console.error(
      "loadCandidates:",
      error
    );


    $("candidatesList").innerHTML = `
      <div class="card empty">
        <strong>Ошибка загрузки</strong>
        ${escapeHtml(
          error.message ||
          "Не удалось загрузить кандидатов"
        )}
      </div>
    `;

    showToast(
      "Не удалось загрузить кандидатов",
      "error"
    );
  }
}


function renderCandidates() {

  const container =
    $("candidatesList");

  if (!container) return;


  const search =
    (
      $("candidateSearch")?.value ||
      ""
    )
      .trim()
      .toLowerCase();


  let list = candidates;


  if (search) {

    list =
      candidates.filter(candidate => {

        const text = [
          candidate.name,
          candidate.phone,
          candidate.specialty,
          candidate.object,
          candidate.comment,
          candidate.status
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

        return text.includes(search);

      });

  }


  if (!list.length) {

    container.innerHTML = `
      <div class="card empty">
        <strong>Кандидатов не найдено</strong>
        Попробуйте изменить поиск.
      </div>
    `;

    return;
  }


  container.innerHTML =
    list
      .map(renderCandidateCard)
      .join("");
}



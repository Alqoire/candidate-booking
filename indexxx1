function createAnalyticsBlock(title, items) {
  const block = document.createElement("div");
  block.className = "analytics-block";

  const heading = document.createElement("div");
  heading.className = "analytics-block-title";
  heading.textContent = title;

  block.appendChild(heading);

  const list = document.createElement("div");
  list.className = "analytics-list";

  if (!items || !items.length) {
    const empty = document.createElement("div");
    empty.className = "analytics-empty";
    empty.textContent = "Нет данных за выбранный период";
    list.appendChild(empty);
  } else {
    const max = Math.max(...items.map(item => Number(item.count) || 0), 1);

    items.forEach(item => {
      const row = document.createElement("div");
      row.className = "analytics-row";

      const name = document.createElement("div");
      name.className = "analytics-name";
      name.textContent = item.name || "Не указано";

      const track = document.createElement("div");
      track.className = "analytics-track";

      const fill = document.createElement("div");
      fill.className = "analytics-fill";
      fill.style.width =
        Math.max(0, Math.min(100, (Number(item.count) / max) * 100)) + "%";

      track.appendChild(fill);

      const value = document.createElement("div");
      value.className = "analytics-value";
      value.textContent = item.count ?? 0;

      row.append(name, track, value);
      list.appendChild(row);
    });
  }

  block.appendChild(list);

  return block;
}

function renderCandidates() {
  const search = document.getElementById("searchInput").value.trim().toLowerCase();
  const status = document.getElementById("statusFilter").value;
  const specialty = document.getElementById("specialtyFilter").value;

  const filtered = allCandidates.filter(candidate => {
    const values = [
      candidate.name,
      candidate.phone,
      candidate.specialty,
      candidate.source,
      candidate.comment,
      candidate.object
    ];

    const matchesSearch = values.some(value =>
      String(value || "").toLowerCase().includes(search)
    ) || (
      (!candidate.name || !candidate.name.trim()) &&
      "без фио".includes(search)
    );

    const matchesStatus = !status || candidate.status === status;
    const matchesSpecialty = !specialty || candidate.specialty === specialty;

    return matchesSearch && matchesStatus && matchesSpecialty;
  });

  const table = document.getElementById("candidatesTable");
  const mobile = document.getElementById("candidatesMobile");

  table.replaceChildren();
  mobile.replaceChildren();

  if (!filtered.length) {
    const row = document.createElement("tr");
    const cell = makeText("td", "empty", "Кандидаты не найдены");
    cell.colSpan = 6;
    row.appendChild(cell);
    table.appendChild(row);
    mobile.appendChild(makeText("div", "empty", "Кандидаты не найдены"));
  } else {
    filtered.forEach(candidate => {
      const row = document.createElement("tr");

      const person = document.createElement("td");
      person.appendChild(createCandidateNameButton(candidate));
      person.appendChild(createPhoneLink(candidate.phone));
      row.appendChild(person);

      row.appendChild(makeText("td", "", candidate.specialty || "—"));
      row.appendChild(makeText("td", "", candidate.source || "Не указан"));
      row.appendChild(makeText("td", "", candidate.added || "—"));
      row.appendChild(makeText("td", "", candidate.meeting || "Не назначена"));

      const statusCell = document.createElement("td");
      statusCell.appendChild(makeStatusSelect(candidate));

      const actions = makeText("div", "candidate-actions", "");

      actions.appendChild(createRescheduleButton(
        candidate,
        hasMeetingId(candidate) ? "Перенести" : "Проверить встречу"
      ));

      if (hasMeetingId(candidate)) {
        actions.appendChild(createCancelButton(candidate, "Отменить"));
      }

      statusCell.appendChild(actions);
      row.appendChild(statusCell);

      table.appendChild(row);
      mobile.appendChild(makeMobileCandidate(candidate));
    });
  }

  document.getElementById("resultCount").textContent =
    "Показано кандидатов: " + filtered.length + " из " + allCandidates.length;
}

function loadCandidates() {
  if (isLoadingCandidates) return;

  isLoadingCandidates = true;

  const refreshButton = document.getElementById("refreshButton");
  refreshButton.disabled = true;
  refreshButton.textContent = "Загрузка...";

  document.getElementById("todayTable").innerHTML =
    '<tr><td colspan="5" class="loading">Загружаем встречи...</td></tr>';

  runServer(
    "getCandidates",
    [],
    result => {
      isLoadingCandidates = false;
      refreshButton.disabled = false;
      refreshButton.textContent = "↻ Обновить";

      if (!result || !result.success) {
        showLoadError(result?.message || "Не удалось загрузить базу");
        return;
      }

      allCandidates = Array.isArray(result.candidates) ? result.candidates : [];

      updateStats(result.stats || {});
      renderTodayCandidates();
      renderCandidates();

      if (document.getElementById("page-calendar").classList.contains("active")) {
        loadCalendar();
      }
    },
    error => {
      isLoadingCandidates = false;
      refreshButton.disabled = false;
      refreshButton.textContent = "↻ Обновить";
      showLoadError(error?.message || "Ошибка соединения");
    }
  );
}

function showLoadError(message) {
  const text = "Ошибка загрузки: " + message;

  ["todayTable", "candidatesTable"].forEach(id => {
    const table = document.getElementById(id);
    table.replaceChildren();

    const row = document.createElement("tr");
    const cell = makeText("td", "empty", text);
    cell.colSpan = id === "todayTable" ? 5 : 6;
    row.appendChild(cell);
    table.appendChild(row);
  });

  document.getElementById("todayMobile").replaceChildren(
    makeText("div", "empty", text)
  );

  document.getElementById("candidatesMobile").replaceChildren(
    makeText("div", "empty", text)
  );
}

function updateStatus(row, status, select) {
  if (!row) {
    notifyError("Не найден номер строки кандидата. Обнови базу.", "Статус");
    loadCandidates();
    return;
  }

  select.disabled = true;

  runServer(
    "updateCandidateStatus",
    [row, status],
    result => {
      select.disabled = false;

      if (!result || !result.success) {
        notifyError("Не удалось изменить статус: " + (result?.message || "Неизвестная ошибка"), "Статус");
        loadCandidates();
        return;
      }

      const candidate = allCandidates.find(item => String(item.row) === String(row));
      if (candidate) candidate.status = status;

      renderTodayCandidates();
      renderCandidates();
    },
    error => {
      select.disabled = false;
      notifyError(error?.message || String(error), "Ошибка");
      loadCandidates();
    }
  );
}

function openRescheduleDialog(candidate) {
  if (!hasMeetingId(candidate)) {
    notifyWarning(
      "Активная встреча не найдена. Возможно, кандидат добавлен без встречи или нет meetingId.",
      "Перенос"
    );
    return;
  }

  const oldModal = document.getElementById("rescheduleModal");
  if (oldModal) oldModal.remove();

  const overlay = document.createElement("div");
  overlay.id = "rescheduleModal";

  Object.assign(overlay.style, {
    position:"fixed",
    inset:"0",
    background:"rgba(5,10,20,.82)",
    backdropFilter:"blur(5px)",
    display:"flex",
    alignItems:"center",
    justifyContent:"center",
    zIndex:"99999",
    padding:"20px"
  });

  const modal = document.createElement("div");

  Object.assign(modal.style, {
    width:"100%",
    maxWidth:"440px",
    maxHeight:"90vh",
    overflowY:"auto",
    background:"#17243A",
    border:"1px solid rgba(214,174,89,.35)",
    borderRadius:"18px",
    padding:"28px",
    boxShadow:"0 25px 80px rgba(0,0,0,.5)",
    color:"#F4F4F4",
    fontFamily:"Arial,sans-serif",
    boxSizing:"border-box"
  });

  modal.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
      <div style="font-size:21px;font-weight:700;color:#D6AE59;">Перенос встречи</div>
      <button id="closeReschedule" type="button" aria-label="Закрыть"
        style="background:none;border:none;color:#9CA8B9;font-size:25px;cursor:pointer;">&times;</button>
    </div>

    <div id="rescheduleCandidate" style="color:#B8C3D3;font-size:14px;margin-bottom:24px;"></div>

    <label style="display:block;font-size:13px;color:#B8C3D3;margin-bottom:8px;">Новая дата</label>
    <input id="rescheduleDate" type="date"
      style="width:100%;height:46px;padding:0 12px;margin-bottom:18px;border-radius:9px;border:1px solid #40516B;background:#101B2D;color:white;font-size:15px;box-sizing:border-box;color-scheme:dark;">

    <label style="display:block;font-size:13px;color:#B8C3D3;margin-bottom:8px;">Новое время</label>
    <input id="rescheduleTime" type="time" value="10:00"
      style="width:100%;height:46px;padding:0 12px;margin-bottom:18px;border-radius:9px;border:1px solid #40516B;background:#101B2D;color:white;font-size:15px;box-sizing:border-box;color-scheme:dark;">

    <label style="display:block;font-size:13px;color:#B8C3D3;margin-bottom:8px;">Причина переноса</label>
    <textarea id="rescheduleReason" placeholder="Например: кандидат попросил перенести встречу..."
      rows="3"
      style="width:100%;padding:12px;margin-bottom:14px;border-radius:9px;border:1px solid #40516B;background:#101B2D;color:white;font-size:14px;resize:vertical;box-sizing:border-box;font-family:Arial,sans-serif;"></textarea>

    <div id="rescheduleError" style="display:none;color:#FF8585;font-size:13px;margin-bottom:14px;"></div>

    <div style="display:flex;gap:10px;margin-top:8px;">
      <button id="cancelReschedule" type="button"
        style="flex:1;padding:13px;border-radius:9px;border:1px solid #40516B;background:#263750;color:#D5DCE6;font-weight:600;cursor:pointer;">Отмена</button>

      <button id="confirmReschedule" type="button"
        style="flex:1;padding:13px;border-radius:9px;border:none;background:#D6AE59;color:#17243A;font-weight:700;cursor:pointer;">Перенести встречу</button>
    </div>
  `;

  overlay.appendChild(modal);
  document.body.appendChild(overlay);

  const dateField = modal.querySelector("#rescheduleDate");
  const timeField = modal.querySelector("#rescheduleTime");
  const reasonField = modal.querySelector("#rescheduleReason");
  const errorBox = modal.querySelector("#rescheduleError");
  const submitButton = modal.querySelector("#confirmReschedule");

  modal.querySelector("#rescheduleCandidate").textContent =
    (candidate.name || "Без ФИО") + " · " +
    (candidate.phone || "Телефон не указан");

  const tomorrow = getTomorrow();
  dateField.value = tomorrow;
  dateField.min = tomorrow;

  function closeModal() {
    overlay.remove();
  }

  modal.querySelector("#closeReschedule").addEventListener("click", closeModal);
  modal.querySelector("#cancelReschedule").addEventListener("click", closeModal);

  overlay.addEventListener("click", event => {
    if (event.target === overlay) closeModal();
  });

  const escapeHandler = event => {
    if (event.key === "Escape") {
      closeModal();
      document.removeEventListener("keydown", escapeHandler);
    }
  };

  document.addEventListener("keydown", escapeHandler);

  submitButton.addEventListener("click", () => {
    const newDate = dateField.value;
    const newTime = timeField.value;
    const reason = reasonField.value.trim();

    errorBox.style.display = "none";

    if (!newDate || !newTime || !reason) {
      errorBox.textContent = "Заполни дату, время и причину переноса.";
      errorBox.style.display = "block";
      return;
    }

    if (newDate < dateField.min) {
      errorBox.textContent = "Выбери дату не раньше завтрашнего дня.";
      errorBox.style.display = "block";
      return;
    }

    const parts = newDate.split("-").map(Number);
    const checkedDate = new Date(parts[0], parts[1] - 1, parts[2]);

    if (
      parts.length !== 3 ||
      checkedDate.getFullYear() !== parts[0] ||
      checkedDate.getMonth() !== parts[1] - 1 ||
      checkedDate.getDate() !== parts[2]
    ) {
      errorBox.textContent = "Указана некорректная дата.";
      errorBox.style.display = "block";
      return;
    }

    const hour = Number(newTime.split(":")[0]);
    const minute = Number(newTime.split(":")[1]);

    if (
      hour < 8 || hour > 19 ||
      (hour === 19 && minute > 0) ||
      ![0, 30].includes(minute)
    ) {
      errorBox.textContent = "Время встречи должно быть с 08:00 до 19:00 с шагом 30 минут.";
      errorBox.style.display = "block";
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Переносим...";

    runServer(
      "rescheduleMeeting",
      [candidate.meetingId, newDate, newTime, reason],
      result => {
        if (!result || !result.success) {
          submitButton.disabled = false;
          submitButton.textContent = "Перенести встречу";
          errorBox.textContent = result?.message || "Не удалось перенести встречу.";
          errorBox.style.display = "block";
          return;
        }

        closeModal();

        if (result.notificationSent === true) {
          notifySuccess("Встреча перенесена. Уведомление отправлено в MAX.", "Перенос");
        } else {
          notifyWarning(
            "Встреча перенесена, но уведомление в MAX не подтверждено. " +
            (result.message || "Проверь GitHub Actions."),
            "Перенос"
          );
        }

        loadCandidates();
      },
      error => {
        submitButton.disabled = false;
        submitButton.textContent = "Перенести встречу";
        errorBox.textContent = "Ошибка: " + (error?.message || error);
        errorBox.style.display = "block";
      }
    );
  });
}

function openCancelDialog(candidate) {
  if (!hasMeetingId(candidate)) {
    notifyWarning("У этого кандидата не найдена активная встреча.", "Встреча");
    return;
  }

  const oldModal = document.getElementById("cancelMeetingModal");
  if (oldModal) oldModal.remove();

  const overlay = document.createElement("div");
  overlay.id = "cancelMeetingModal";

  Object.assign(overlay.style, {
    position:"fixed",
    inset:"0",
    background:"rgba(5,10,20,.82)",
    backdropFilter:"blur(5px)",
    display:"flex",
    alignItems:"center",
    justifyContent:"center",
    zIndex:"99999",
    padding:"20px"
  });

  const modal = document.createElement("div");

  Object.assign(modal.style, {
    width:"100%",
    maxWidth:"440px",
    background:"#17243A",
    border:"1px solid rgba(214,80,80,.4)",
    borderRadius:"18px",
    padding:"28px",
    boxShadow:"0 25px 80px rgba(0,0,0,.5)",
    color:"#F4F4F4",
    fontFamily:"Arial,sans-serif",
    boxSizing:"border-box"
  });

  modal.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
      <div style="font-size:21px;font-weight:700;color:#FF8585;">Отмена встречи</div>
      <button id="closeCancelMeeting" type="button"
        style="background:none;border:none;color:#9CA8B9;font-size:25px;cursor:pointer;">&times;</button>
    </div>

    <div id="cancelCandidateInfo"
      style="color:#B8C3D3;font-size:14px;margin-bottom:20px;"></div>

    <div style="padding:14px;background:#263750;border-radius:9px;margin-bottom:20px;color:#FFD0D0;font-size:13px;">
      Встреча будет удалена из Google Календаря, а её статус изменится на «Отменена».
    </div>

    <label style="display:block;font-size:13px;color:#B8C3D3;margin-bottom:8px;">
      Причина отмены
    </label>

    <textarea id="cancelMeetingReason"
      placeholder="Например: кандидат отказался от поездки..."
      rows="3"
      style="width:100%;padding:12px;margin-bottom:14px;border-radius:9px;border:1px solid #40516B;background:#101B2D;color:white;font-size:14px;resize:vertical;box-sizing:border-box;font-family:Arial,sans-serif;"></textarea>

    <div id="cancelMeetingError"
      style="display:none;color:#FF8585;font-size:13px;margin-bottom:14px;"></div>

    <div style="display:flex;gap:10px;margin-top:8px;">
      <button id="cancelMeetingBack" type="button"
        style="flex:1;padding:13px;border-radius:9px;border:1px solid #40516B;background:#263750;color:#D5DCE6;font-weight:600;cursor:pointer;">
        Назад
      </button>

      <button id="confirmCancelMeeting" type="button"
        style="flex:1;padding:13px;border-radius:9px;border:none;background:#C94D4D;color:white;font-weight:700;cursor:pointer;">
        Отменить встречу
      </button>
    </div>
  `;

  overlay.appendChild(modal);
  document.body.appendChild(overlay);

  const reasonField = modal.querySelector("#cancelMeetingReason");
  const errorBox = modal.querySelector("#cancelMeetingError");
  const submitButton = modal.querySelector("#confirmCancelMeeting");

  modal.querySelector("#cancelCandidateInfo").textContent =
    (candidate.name || "Без ФИО") + " · " +
    (candidate.phone || "Телефон не указан");

  function closeModal() {
    overlay.remove();
  }

  modal.querySelector("#closeCancelMeeting").addEventListener("click", closeModal);
  modal.querySelector("#cancelMeetingBack").addEventListener("click", closeModal);

  overlay.addEventListener("click", event => {
    if (event.target === overlay) closeModal();
  });

  const escapeHandler = event => {
    if (event.key === "Escape") {
      closeModal();
      document.removeEventListener("keydown", escapeHandler);
    }
  };

  document.addEventListener("keydown", escapeHandler);

  submitButton.addEventListener("click", () => {
    const reason = reasonField.value.trim();

    errorBox.style.display = "none";

    if (!reason) {
      errorBox.textContent = "Укажи причину отмены встречи.";
      errorBox.style.display = "block";
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Отменяем...";

    runServer(
      "cancelMeeting",
      [candidate.meetingId, reason],
      result => {
        if (!result || !result.success) {
          submitButton.disabled = false;
          submitButton.textContent = "Отменить встречу";
          errorBox.textContent = result?.message || "Не удалось отменить встречу.";
          errorBox.style.display = "block";
          return;
        }

        closeModal();

        if (result.notificationSent === true) {
          notifySuccess("Встреча отменена. Уведомление отправлено в MAX.", "Отмена");
        } else {
          notifyWarning(
            "Встреча отменена, но уведомление в MAX не подтверждено. " +
            (result.message || "Проверь GitHub Actions."),
            "Отмена"
          );
        }

        loadCandidates();
      },
      error => {
        submitButton.disabled = false;
        submitButton.textContent = "Отменить встречу";
        errorBox.textContent = "Ошибка: " + (error?.message || error);
        errorBox.style.display = "block";
      }
    );
  });
}

document.getElementById("searchInput")
  .addEventListener("input", renderCandidates);

document.getElementById("statusFilter")
  .addEventListener("change", renderCandidates);

document.getElementById("specialtyFilter")
  .addEventListener("change", renderCandidates);

const form = document.getElementById("candidateForm");
const submitButton = document.getElementById("submitButton");
const formMessage = document.getElementById("formMessage");

form.addEventListener("submit", event => {
  event.preventDefault();

  if (isSubmittingCandidate) return;
  if (!form.reportValidity()) return;

  isSubmittingCandidate = true;
  submitButton.disabled = true;
  submitButton.textContent = "Сохраняем...";
  formMessage.className = "message";
  formMessage.textContent = "";

  const data = Object.fromEntries(new FormData(form).entries());

  runServer(
    "createCandidate",
    [data],
    result => {
      isSubmittingCandidate = false;
      submitButton.disabled = false;
      submitButton.textContent = "Добавить кандидата и создать встречу";

      if (!result || !result.success) {
        const errText = result?.message || "Не удалось создать встречу";
        formMessage.textContent = errText;
        formMessage.className = "message error";

        if (result && result.duplicate) {
          notifyWarning(errText, "Дубликат");
        } else {
          notifyError(errText, "Добавление");
        }
        return;
      }

      formMessage.textContent =
        "Кандидат сохранён, встреча создана в календаре.";
      formMessage.className = "message success";

      notifySuccess(
        (data.name || "Кандидат") + " записан на " +
        (data.date || "") + " в " + (data.time || "") + ".",
        "Кандидат добавлен"
      );

      form.reset();
      dateInput.value = getTomorrow();
      dateInput.min = getTomorrow();
      timeSelect.value = "10:00";
      loadObjects();
      loadCandidates();

      // Плавно убираем зелёный блок под формой
      setTimeout(() => {
        formMessage.className = "message";
        formMessage.textContent = "";
      }, 4500);
    },
    error => {
      isSubmittingCandidate = false;
      submitButton.disabled = false;
      submitButton.textContent = "Добавить кандидата и создать встречу";

      const errText = error?.message || String(error);
      formMessage.textContent = errText;
      formMessage.className = "message error";
      notifyError(errText, "Добавление");
    }
  );
});

form.addEventListener("reset", () => {
  setTimeout(() => {
    dateInput.value = getTomorrow();
    dateInput.min = getTomorrow();
    timeSelect.value = "10:00";
    formMessage.className = "message";
    formMessage.textContent = "";
  }, 0);
});

loadObjects();
loadCandidates();
</script>

function hasMeetingId(candidate) {
  return candidate.meetingId !== undefined &&
    candidate.meetingId !== null &&
    String(candidate.meetingId).trim() !== "";
}

function normalizePhone(phone) {
  return String(phone || "").replace(/[^\d+]/g, "");
}

function createPhoneLink(phone) {
  const link = document.createElement("a");
  const normalized = normalizePhone(phone);

  link.className = "phone-link";
  link.textContent = phone || "Телефон не указан";

  if (normalized) {
    link.href = "tel:" + normalized;
  } else {
    link.removeAttribute("href");
  }

  return link;
}

async function copyPhone(phone) {
  const value = String(phone || "").trim();

  if (!value) {
    notifyWarning("Номер телефона отсутствует.", "Телефон");
    return false;
  }

  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
    } else {
      const textarea = document.createElement("textarea");
      textarea.value = value;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();

      const copied = document.execCommand("copy");
      textarea.remove();

      if (!copied) throw new Error("Не удалось скопировать номер");
    }

    return true;
  } catch (error) {
    console.error("Ошибка копирования:", error);
    notifyWarning("Не удалось скопировать. Номер: " + value, "Телефон");
    return false;
  }
}

function createQuickActions(candidate) {
  const actions = makeText("div", "quick-actions", "");

  const phone = String(candidate.phone || "").trim();

  const call = document.createElement("a");
  call.className = "quick-btn call";
  call.textContent = "☎ Позвонить";

  if (phone) {
    call.href = "tel:" + normalizePhone(phone);
  } else {
    call.href = "#";
    call.addEventListener("click", event => {
      event.preventDefault();
      notifyWarning("У кандидата не указан номер телефона.", "Телефон");
    });
  }

  const maxButton = document.createElement("button");
  maxButton.type = "button";
  maxButton.className = "quick-btn max";
  maxButton.textContent = "✉ MAX · скопировать номер ";

  maxButton.addEventListener("click", async () => {
    if (!phone) {
      notifyWarning("У кандидата не указан номер телефона.", "Телефон");
      return;
    }

    // Открываем MAX синхронно в обработчике клика,
    // чтобы браузер не заблокировал новую вкладку из-за await.
    window.open("https://web.max.ru/", "_blank", "noopener,noreferrer");

    // Копируем номер в буфер без лишнего успешного уведомления.
    await copyPhone(phone);
  });

  const copyButton = document.createElement("button");
  copyButton.type = "button";
  copyButton.className = "quick-btn copy";
  copyButton.textContent = "▣ Копировать";

  copyButton.addEventListener("click", async () => {
    const copied = await copyPhone(phone);

    if (copied) {
      const oldText = copyButton.textContent;
      copyButton.textContent = "✓ Скопировано";

      setTimeout(() => {
        copyButton.textContent = oldText;
      }, 1500);
    }
  });

  actions.appendChild(call);
  actions.appendChild(maxButton);
  actions.appendChild(copyButton);

  return actions;
}


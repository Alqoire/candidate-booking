/* =========================================================
   SWIPE DOWN ДЛЯ BOTTOM SHEET
========================================================= */

document
  .querySelectorAll(".sheet")
  .forEach(sheet => {

    let startY = 0;
    let currentY = 0;


    sheet.addEventListener(
      "touchstart",
      event => {

        if (
          sheet.scrollTop > 0
        ) {
          return;
        }

        startY =
          event.touches[0].clientY;

      },
      { passive: true }
    );


    sheet.addEventListener(
      "touchmove",
      event => {

        currentY =
          event.touches[0].clientY;

      },
      { passive: true }
    );


    sheet.addEventListener(
      "touchend",
      () => {

        const distance =
          currentY - startY;


        if (
          startY > 0 &&
          distance > 100
        ) {

          const modal =
            sheet.closest(".modal");

          if (modal) {
            closeModal(
              modal.id
            );
          }

        }


        startY = 0;
        currentY = 0;

      }
    );

  });



function loadObjects(selectedObject) {
  const select = document.getElementById("object");
  select.disabled = true;
  select.innerHTML = '<option value="">Загрузка объектов...</option>';

  runServer(
    "getObjects",
    [],
    objects => {
      select.replaceChildren();

      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "Выберите объект";
      select.appendChild(placeholder);

      (Array.isArray(objects) ? objects : []).forEach(name => {
        const option = document.createElement("option");
        option.value = name;
        option.textContent = name;
        select.appendChild(option);
      });

      if (selectedObject && (objects || []).includes(selectedObject)) {
        select.value = selectedObject;
      }

      select.disabled = false;
    },
    error => {
      select.innerHTML = '<option value="">Ошибка загрузки объектов</option>';
      select.disabled = false;
      console.error("Ошибка загрузки объектов:", error);
    }
  );
}

function showNewObjectInput() {
  const box = document.getElementById("newObjectBox");
  const input = document.getElementById("newObjectName");

  box.style.display = box.style.display === "none" ? "block" : "none";

  if (box.style.display === "block") input.focus();
}

function saveNewObject() {
  const input = document.getElementById("newObjectName");
  const button = document.querySelector("#newObjectBox button");
  const name = input.value.trim();

  if (!name) {
    notifyWarning("Введите название объекта.", "Объект");
    input.focus();
    return;
  }

  button.disabled = true;
  button.textContent = "Сохраняем...";

  runServer(
    "addObject",
    [name],
    result => {
      button.disabled = false;
      button.textContent = "Сохранить объект";

      if (!result || !result.success) {
        notifyError(result?.message || "Не удалось сохранить объект.", "Объект");
        return;
      }

      loadObjects(name);
      input.value = "";
      document.getElementById("newObjectBox").style.display = "none";
      notifySuccess("Объект сохранён в списке.", "Объект");
    },
    error => {
      button.disabled = false;
      button.textContent = "Сохранить объект";
      notifyError(error?.message || String(error), "Ошибка");
    }
  );
}

function applyStatusColor(select, status) {
  select.classList.remove(
    "status-working",
    "status-trial",
    "status-arrived",
    "status-rejected",
    "status-new"
  );

  if (status === "Работает") {
    select.classList.add("status-working");
  } else if (status === "На испытательном сроке") {
    select.classList.add("status-trial");
  } else if (status === "Приехал на объект" || status === "Записан") {
    select.classList.add("status-arrived");
  } else if (
    status === "Отказ" ||
    status === "Не приехал" ||
    status === "Не прошёл испытательный срок"
  ) {
    select.classList.add("status-rejected");
  } else {
    select.classList.add("status-new");
  }
}

function makeStatusSelect(candidate) {
  const select = document.createElement("select");
  select.className = "status-select";

  if (candidate.status && !STATUSES.includes(candidate.status)) {
    const legacyOption = document.createElement("option");
    legacyOption.value = candidate.status;
    legacyOption.textContent = "Старый статус: " + candidate.status;
    legacyOption.selected = true;
    select.appendChild(legacyOption);
  }

  STATUSES.forEach(status => {
    const option = document.createElement("option");
    option.value = status;
    option.textContent = status;
    option.selected = candidate.status === status;
    select.appendChild(option);
  });

  applyStatusColor(select, candidate.status);

  select.addEventListener("change", () => {
    applyStatusColor(select, select.value);
    updateStatus(candidate.row, select.value, select);
  });

  return select;
}


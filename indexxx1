function openCandidateProfile(candidate) {
  if (!candidate || !candidate.candidateId) {
    notifyWarning("У кандидата отсутствует ID.", "Профиль");
    return;
  }

  const old = document.getElementById("candidateProfileModal");
  if (old) old.remove();

  const overlay = document.createElement("div");
  overlay.id = "candidateProfileModal";

  Object.assign(overlay.style, {
    position: "fixed",
    inset: "0",
    zIndex: "100001",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    padding: "16px",
    background: "rgba(5,10,20,.84)",
    backdropFilter: "blur(6px)"
  });

  const modal = document.createElement("div");

  Object.assign(modal.style, {
    width: "100%",
    maxWidth: "760px",
    maxHeight: "92vh",
    overflowY: "auto",
    padding: "24px",
    borderRadius: "16px",
    border: "1px solid #354258",
    background: "#171e29",
    color: "#eef1f6",
    boxShadow: "0 25px 80px rgba(0,0,0,.55)"
  });

  overlay.appendChild(modal);
  document.body.appendChild(overlay);

  function closeProfile() {
    overlay.remove();
    document.removeEventListener("keydown", escapeHandler);
  }

  const escapeHandler = event => {
    if (event.key === "Escape") closeProfile();
  };

  document.addEventListener("keydown", escapeHandler);

  overlay.addEventListener("click", event => {
    if (event.target === overlay) closeProfile();
  });

  const loading = makeText(
    "div",
    "loading",
    "Загружаем профиль кандидата..."
  );

  loading.style.padding = "45px 10px";
  loading.style.textAlign = "center";
  modal.appendChild(loading);

  runServer(
    "getCandidateProfile",
    [candidate.candidateId],

    result => {
      if (!result || !result.success || !result.candidate) {
        modal.replaceChildren();
        modal.appendChild(makeText(
          "div",
          "empty",
          result?.message || "Не удалось загрузить профиль."
        ));
        return;
      }

      renderCandidateProfile(
        modal,
        result,
        candidate,
        closeProfile
      );
    },

    error => {
      modal.replaceChildren();
      modal.appendChild(makeText(
        "div",
        "empty",
        "Ошибка загрузки: " + (error?.message || error)
      ));
    }
  );

  return closeProfile;
}



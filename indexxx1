/* =========================================================
   ДОБАВЛЕНИЕ КАНДИДАТА
========================================================= */

async function openAddCandidate() {

  await loadObjectsIntoSelect();


  const form =
    $("candidateForm");

  if (form) {
    form.reset();
  }


  const date =
    $("newDate");

  if (date) {
    date.value =
      getTodayYmd();
  }


  const time =
    $("newTime");

  if (time && !time.value) {
    time.value = "10:00";
  }


  openModal(
    "candidateModal"
  );
}


async function loadObjectsIntoSelect() {

  try {

    const result =
      await serverCall(
        "getObjects"
      );


    if (
      result &&
      result.success &&
      Array.isArray(result.objects)
    ) {

      objects =
        result.objects;

    } else if (
      Array.isArray(result)
    ) {

      objects = result;

    } else {

      objects = [];

    }


    const select =
      $("newObject");

    if (!select) return;


    select.innerHTML = `
      <option value="">
        Выберите объект
      </option>
    `;


    objects.forEach(object => {

      const value =
        typeof object === "string"
          ? object
          : (
              object.name ||
              object.objectName ||
              object.title ||
              ""
            );


      if (!value) return;


      const option =
        document.createElement(
          "option"
        );

      option.value = value;
      option.textContent = value;

      select.appendChild(option);

    });


  } catch (error) {

    console.error(
      "loadObjectsIntoSelect:",
      error
    );

    showToast(
      "Не удалось загрузить объекты",
      "error"
    );
  }
}


async function createCandidateFromForm(event) {

  event.preventDefault();


  const submit =
    event.submitter;


  if (submit) {
    submit.disabled = true;
    submit.textContent =
      "Сохраняем...";
  }


  const data = {

    name:
      $("newName")?.value.trim() || "",

    phone:
      $("newPhone")?.value.trim() || "",

    specialty:
      $("newSpecialty")?.value.trim() || "",

    object:
      $("newObject")?.value || "",

    date:
      $("newDate")?.value || "",

    time:
      $("newTime")?.value || "",

    comment:
      $("newComment")?.value.trim() || ""

  };


  try {

    const result =
      await serverCall(
        "createCandidate",
        data
      );


    if (
      !result ||
      !result.success
    ) {

      throw new Error(
        result && result.error
          ? result.error
          : "Не удалось создать кандидата"
      );

    }


    closeModal(
      "candidateModal"
    );


    showToast(
      "Кандидат сохранён, встреча создана.",
      "success"
    );


    await refreshAll();


  } catch (error) {

    console.error(
      "createCandidate:",
      error
    );


    showToast(
      error.message ||
      "Ошибка при создании кандидата",
      "error"
    );


  } finally {

    if (submit) {
      submit.disabled = false;
      submit.textContent =
        "Добавить кандидата";
    }

  }
}

<script>


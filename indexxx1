    "button",
    "primary-btn",
    "Сохранить заметку"
  );

  saveButton.type = "button";
  saveButton.style.marginTop = "10px";

  saveButton.addEventListener("click", () => {
    const note = textarea.value.trim();

    if (!note) {
      notifyWarning("Напиши текст заметки.", "Заметка");
      textarea.focus();
      return;
    }

    saveButton.disabled = true;
    saveButton.textContent = "Сохраняем...";

    runServer(
      "addCandidateNote",
      [candidate.candidateId, note],

      result => {
        if (!result || !result.success) {
          saveButton.disabled = false;
          saveButton.textContent = "Сохранить заметку";

          notifyError(
            result?.message || "Не удалось сохранить заметку.",
            "Заметка"
          );

          return;
        }

        notifySuccess("Заметка добавлена в историю.", "Профиль");

        closeProfile();

        const updatedCandidate = allCandidates.find(
          item => item.candidateId === candidate.candidateId
        ) || originalCandidate;

        openCandidateProfile(updatedCandidate);
      },

      error => {
        saveButton.disabled = false;
        saveButton.textContent = "Сохранить заметку";

        notifyError(
          error?.message || String(error),
          "Заметка"
        );
      }
    );
  });

  noteSection.appendChild(textarea);
  noteSection.appendChild(saveButton);
  modal.appendChild(noteSection);
}


/* =========================================================
   СТАТУС
========================================================= */

async function updateCandidateStatusMobile(
  candidateId,
  status
) {

  if (!candidateId || !status) {
    return;
  }


  try {

    const result =
      await serverCall(
        "updateCandidateStatus",
        candidateId,
        status
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось изменить статус"
      );
    }


    showToast(
      "Статус обновлён",
      "success"
    );


    await refreshAll();


    if (
      currentCandidateId === candidateId
    ) {
      await openCandidateProfile(
        candidateId
      );
    }


  } catch (error) {

    console.error(
      "updateCandidateStatus:",
      error
    );

    showToast(
      error.message ||
      "Не удалось изменить статус",
      "error"
    );
  }
}


/* =========================================================
   ЗАМЕТКА
========================================================= */

async function addCandidateNoteMobile(
  candidateId
) {

  if (!candidateId) return;


  const note =
    window.prompt(
      "Введите заметку"
    );


  if (!note || !note.trim()) {
    return;
  }


  try {

    const result =
      await serverCall(
        "addCandidateNote",
        candidateId,
        note.trim()
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось добавить заметку"
      );
    }


    showToast(
      "Заметка добавлена",
      "success"
    );


    await openCandidateProfile(
      candidateId
    );


  } catch (error) {

    console.error(
      "addCandidateNote:",
      error
    );

    showToast(
      error.message ||
      "Не удалось добавить заметку",
      "error"
    );
  }
}


/* =========================================================
   ВСТРЕЧИ
========================================================= */

function getCurrentMeetingYmd() {
  return dateToYmd(
    currentMeetingDate
  );
}


function updateMeetingHeader() {

  const period =
    $("meetingsPeriod");

  if (!period) return;

  period.textContent =
    formatDateRu(
      currentMeetingDate
    );
}


async function loadMeetings() {

  updateMeetingHeader();


  const date =
    getCurrentMeetingYmd();


  setLoading(
    "meetingsList",
    "Загружаем встречи"
  );


  try {

    /*
      Обязательно две даты.
      Для мобильного дневного режима
      startDate === endDate.
    */

    const result =
      await serverCall(
        "getCalendarMeetings",
        date,
        date
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось загрузить встречи"
      );
    }


    meetings =
      result &&
      Array.isArray(result.meetings)
        ? result.meetings
        : [];


    renderMeetings();


  } catch (error) {

    console.error(
      "loadMeetings:",
      error
    );


    $("meetingsList").innerHTML = `
      <div class="card empty">
        <strong>Ошибка загрузки</strong>
        ${escapeHtml(
          error.message ||
          "Не удалось загрузить встречи"
        )}
      </div>
    `;

    showToast(
      "Не удалось загрузить встречи",
      "error"
    );
  }
}



/**
 * Безопасный вызов серверных функций Google Apps Script.
 * В локальном предпросмотре (без google) не падает, а показывает понятное сообщение.
 */
function isGoogleScriptAvailable() {
  return typeof google !== "undefined" &&
    google &&
    google.script &&
    typeof google.script.run === "object";
}

function runServer(functionName, args, onSuccess, onFailure) {
  const fail = typeof onFailure === "function" ? onFailure : function () {};
  const ok = typeof onSuccess === "function" ? onSuccess : function () {};

  if (!isGoogleScriptAvailable()) {
    console.warn(
      "[STROY PODRYAD] google.script.run недоступен. " +
      "Открой приложение через развёрнутый Google Apps Script Web App."
    );
    fail({
      message:
        "Локальный режим: сервер Google Apps Script недоступен. " +
        "Открой ссылку Web App из развёртывания GAS."
    });
    return;
  }

  let runner = google.script.run
    .withSuccessHandler(ok)
    .withFailureHandler(function (error) {
      fail(error || { message: "Ошибка сервера" });
    });

  if (typeof runner[functionName] !== "function") {
    fail({ message: "Серверная функция не найдена: " + functionName });
    return;
  }

  runner[functionName].apply(runner, Array.isArray(args) ? args : []);
}


function showToast(message, type, title, duration) {
  type = type || "info";
  duration = duration == null ? 4200 : duration;

  const container = document.getElementById("toastContainer");
  if (!container) {
    console.log("[toast]", type, message);
    return;
  }

  const icons = {
    success: "✓",
    error: "!",
    warning: "!",
    info: "i"
  };

  const titles = {
    success: title || "Готово",
    error: title || "Ошибка",
    warning: title || "Внимание",
    info: title || "Сообщение"
  };

  const toast = document.createElement("div");
  toast.className = "toast " + type;
  toast.setAttribute("role", "status");

  const icon = document.createElement("div");
  icon.className = "toast-icon";
  icon.textContent = icons[type] || "i";

  const body = document.createElement("div");
  body.className = "toast-body";

  const titleEl = document.createElement("div");
  titleEl.className = "toast-title";
  titleEl.textContent = titles[type];

  const textEl = document.createElement("div");
  textEl.className = "toast-text";
  textEl.textContent = String(message || "");

  body.appendChild(titleEl);
  body.appendChild(textEl);

  const close = document.createElement("button");
  close.type = "button";
  close.className = "toast-close";
  close.setAttribute("aria-label", "Закрыть");
  close.textContent = "×";

  toast.appendChild(icon);
  toast.appendChild(body);
  toast.appendChild(close);
  container.appendChild(toast);

  // animate in
  requestAnimationFrame(() => {
    requestAnimationFrame(() => toast.classList.add("show"));
  });

  let closed = false;

  function closeToast() {
    if (closed) return;
    closed = true;
    toast.classList.remove("show");
    toast.classList.add("hide");
    setTimeout(() => toast.remove(), 300);
  }

  close.addEventListener("click", closeToast);

  if (duration > 0) {
    setTimeout(closeToast, duration);
  }

  return closeToast;
}

function notifySuccess(message, title) {
  return showToast(message, "success", title);
}

function notifyError(message, title) {
  return showToast(message, "error", title, 6000);
}

function notifyWarning(message, title) {
  return showToast(message, "warning", title, 5500);
}

function notifyInfo(message, title) {
  return showToast(message, "info", title);
}


function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

function makeText(tag, className, value) {
  const element = document.createElement(tag);
  if (className) element.className = className;
  element.textContent = value ?? "";
  return element;
}


<!DOCTYPE html>
<html lang="ru">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover">

  <meta name="theme-color" content="#f5f5f7">

  <title>CRM</title>

  <style>
    :root {
      --bg: #f5f5f7;
      --card: #ffffff;
      --text: #17181c;
      --muted: #8a8d96;
      --line: #e7e7eb;
      --accent: #17181c;
      --accent-soft: #eeeeF1;
      --green: #248a5b;
      --red: #d84b4b;
      --yellow: #b68119;
      --blue: #4779c7;

      --radius-xl: 26px;
      --radius-lg: 20px;
      --radius-md: 16px;

      --nav-height: 78px;
      --safe-bottom: env(safe-area-inset-bottom);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      min-height: 100%;
      background: var(--bg);
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "SF Pro Display",
        "SF Pro Text",
        "Inter",
        Arial,
        sans-serif;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      padding-bottom: calc(var(--nav-height) + var(--safe-bottom) + 20px);
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    button:active {
      transform: scale(.98);
    }

    input,
    select,
    textarea {
      outline: none;
    }

    /* ---------- APP ---------- */

    .app {
      width: 100%;
      max-width: 700px;
      margin: 0 auto;
    }

    .screen {
      display: none;
      padding: 20px 18px 28px;
    }

    .screen.active {
      display: block;
    }

    /* ---------- HEADER ---------- */

    .header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
    }

    .header-copy {
      min-width: 0;
    }

    .eyebrow {
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .01em;
    }

    .page-title {
      margin: 0;
      font-size: 32px;
      line-height: 1.08;
      font-weight: 800;
      letter-spacing: -.045em;
    }

    .page-subtitle {
      margin-top: 8px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.4;
    }

    .header-action {
      width: 48px;
      height: 48px;
      flex: 0 0 48px;
      border-radius: 16px;
      background: var(--card);
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
      color: var(--text);
      box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    .header-action svg {
      width: 22px;
      height: 22px;
    }

    /* ---------- SVG ---------- */

    .icon {
      width: 22px;
      height: 22px;
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ---------- STATS ---------- */

    .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .stat {
      min-height: 128px;
      padding: 18px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 7px 25px rgba(0,0,0,.035);
    }

    .stat-label {
      color: var(--muted);
      font-size: 14px;
      font-weight: 600;
    }

    .stat-value {
      margin-top: 12px;
      font-size: 38px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: -.05em;
    }

    .stat-note {
      margin-top: 9px;
      color: var(--muted);
      font-size: 12px;
    }

    /* ---------- SECTIONS ---------- */

    .section {
      margin-top: 18px;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 11px;
    }

    .section-title {
      margin: 0;
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -.025em;
    }

    .section-link {
      color: var(--muted);
      background: transparent;
      font-size: 14px;
      font-weight: 700;
      padding: 7px 0;
    }

    /* ---------- CARDS ---------- */

    .card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 7px 25px rgba(0,0,0,.035);
    }

    .empty {
      padding: 30px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 15px;
    }

    .empty strong {
      display: block;
      margin-bottom: 5px;
      color: var(--text);
      font-size: 17px;
    }

    /* ---------- TODAY MEETING ---------- */

    .today-list {
      display: grid;
      gap: 10px;
    }

    .today-card {
      width: 100%;
      padding: 18px;
      text-align: left;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 7px 25px rgba(0,0,0,.035);
    }

    .today-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .today-name {
      font-size: 18px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -.025em;
    }

    .today-specialty {
      margin-top: 5px;
      color: var(--muted);
      font-size: 14px;
    }

    .today-time {
      flex: 0 0 auto;
      padding: 7px 10px;
      border-radius: 11px;
      background: var(--accent-soft);
      font-size: 14px;
      font-weight: 800;
    }

    .today-meta {
      display: grid;
      gap: 5px;
      margin-top: 14px;
      color: var(--muted);
      font-size: 13px;
    }

    /* ---------- CANDIDATES ---------- */

    .candidate-list {
      display: grid;
      gap: 10px;
    }

    .candidate-card {
      padding: 17px;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 7px 25px rgba(0,0,0,.035);
    }

    .candidate-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .candidate-name {
      font-size: 18px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -.025em;
    }

    .candidate-specialty {
      margin-top: 5px;
      color: var(--muted);
      font-size: 14px;
    }

    .candidate-status {
      flex: 0 0 auto;
      padding: 7px 10px;
      border-radius: 999px;
      background: var(--accent-soft);
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
    }

    .candidate-info {
      display: grid;
      gap: 5px;
      margin-top: 14px;
      color: var(--muted);
      font-size: 14px;
    }

    .candidate-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 14px;
    }

    /* ---------- BUTTONS ---------- */

    .btn {
      min-height: 48px;
      padding: 0 16px;
      border-radius: 15px;
      font-size: 15px;
      font-weight: 750;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-dark {
      background: var(--accent);
      color: white;
    }

    .btn-light {
      background: var(--accent-soft);
      color: var(--text);
    }

    .btn-outline {
      background: white;
      border: 1px solid var(--line);
      color: var(--text);
    }

    .btn-danger {
      background: #fff0f0;
      color: var(--red);
    }

    .btn svg {
      width: 19px;
      height: 19px;
    }

    /* ---------- SEARCH ---------- */

    .search {
      position: relative;
      margin-bottom: 13px;
    }

    .search input {
      width: 100%;
      height: 52px;
      padding: 0 17px 0 47px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: white;
      color: var(--text);
      font-size: 16px;
    }

    .search svg {
      position: absolute;
      left: 17px;
      top: 15px;
      width: 21px;
      height: 21px;
      color: var(--muted);
    }

    /* ---------- FLOATING ADD ---------- */

    .fab {
      position: fixed;
      right: 18px;
      bottom: calc(var(--nav-height) + var(--safe-bottom) + 18px);
      z-index: 50;

      width: 58px;
      height: 58px;
      border-radius: 20px;

      background: var(--accent);
      color: white;

      display: grid;
      place-items: center;

      box-shadow:
        0 12px 30px rgba(0,0,0,.18),
        0 3px 8px rgba(0,0,0,.08);
    }

    .fab svg {
      width: 25px;
      height: 25px;
    }

    /* ---------- BOTTOM NAV ---------- */

    .bottom-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;

      height: calc(var(--nav-height) + var(--safe-bottom));
      padding: 7px 10px var(--safe-bottom);

      display: grid;
      grid-template-columns: repeat(5, 1fr);

      background: rgba(255,255,255,.94);
      border-top: 1px solid rgba(0,0,0,.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .nav-item {
      min-width: 0;
      background: transparent;
      color: #9a9ca3;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;

      font-size: 11px;
      font-weight: 650;
    }

    .nav-item svg {
      width: 24px;
      height: 24px;
      stroke-width: 1.8;
    }

    .nav-item.active {
      color: var(--text);
    }

    .nav-item.active svg {
      stroke-width: 2.3;
    }

    /* ---------- FORMS ---------- */

    .form {
      display: grid;
      gap: 14px;
    }

    .field {
      display: grid;
      gap: 7px;
    }

    .field label {
      font-size: 14px;
      font-weight: 750;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      min-height: 52px;
      padding: 0 15px;

      border: 1px solid var(--line);
      border-radius: 16px;

      background: white;
      color: var(--text);
      font-size: 16px;
    }

    .field textarea {
      min-height: 110px;
      padding-top: 14px;
      padding-bottom: 14px;
      resize: vertical;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus,
    .search input:focus {
      border-color: #a9abb2;
      box-shadow: 0 0 0 3px rgba(0,0,0,.04);
    }

    .form-actions {
      display: grid;
      gap: 9px;
      margin-top: 6px;
    }

    /* ---------- MEETINGS ---------- */

    .meeting-list {
      display: grid;
      gap: 10px;
    }

    .meeting-card {
      padding: 17px;
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: 0 7px 25px rgba(0,0,0,.035);
    }

    .meeting-date {
      color: var(--muted);
      font-size: 13px;
      font-weight: 650;
    }

    .meeting-time {
      margin-top: 5px;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -.035em;
    }

    .meeting-name {
      margin-top: 12px;
      font-size: 18px;
      font-weight: 800;
    }

    .meeting-meta {
      margin-top: 5px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .meeting-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-top: 15px;
    }

    /* ---------- OBJECTS ---------- */

    .object-list {
      display: grid;
      gap: 9px;
    }

    .object-card {
      padding: 17px;
      background: white;
      border: 1px solid var(--line);
      border-radius: 17px;
      font-size: 16px;
      font-weight: 750;
    }

    /* ---------- MODAL ---------- */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 100;

      display: none;
      align-items: flex-end;
      justify-content: center;

      background: rgba(0,0,0,.35);
      padding: 0;
    }

    .modal.open {
      display: flex;
    }

    .sheet {
      width: 100%;
      max-width: 700px;
      max-height: 92vh;
      overflow-y: auto;

      padding: 12px 18px calc(22px + var(--safe-bottom));

      background: #fff;
      border-radius: 28px 28px 0 0;

      box-shadow: 0 -20px 60px rgba(0,0,0,.18);
    }

    .sheet-handle {
      width: 38px;
      height: 5px;
      margin: 0 auto 20px;
      border-radius: 999px;
      background: #d7d7dc;
    }

    .sheet-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .sheet-title {
      margin: 0;
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -.035em;
    }

    .sheet-close {
      width: 40px;
      height: 40px;
      border-radius: 13px;
      background: var(--accent-soft);
      display: grid;
      place-items: center;
    }

    .sheet-close svg {
      width: 20px;
      height: 20px;
    }

    /* ---------- TOAST ---------- */

    .toast {
      position: fixed;
      left: 16px;
      right: 16px;
      top: calc(14px + env(safe-area-inset-top));
      z-index: 200;

      padding: 15px 17px;
      border-radius: 17px;

      background: #17181c;
      color: white;

      font-size: 14px;
      font-weight: 650;
      line-height: 1.4;

      box-shadow: 0 14px 40px rgba(0,0,0,.2);

      transform: translateY(-130%);
      opacity: 0;
      transition: .25s ease;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* ---------- LOADING ---------- */

    .loading {
      padding: 32px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 14px;
    }

    .spinner {
      width: 25px;
      height: 25px;
      margin: 0 auto 10px;
      border: 3px solid #e5e5e8;
      border-top-color: var(--text);
      border-radius: 50%;
      animation: spin .7s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ---------- DESKTOP SAFETY ---------- */

    @media (min-width: 701px) {
      body {
        background: #f5f5f7;
      }

      .app {
        max-width: 760px;
      }

      .bottom-nav {
        left: 50%;
        right: auto;
        width: 700px;
        transform: translateX(-50%);
        border-left: 1px solid rgba(0,0,0,.08);
        border-right: 1px solid rgba(0,0,0,.08);
      }

      .fab {
        right: max(18px, calc((100vw - 700px) / 2 + 18px));
      }
    }

    @media (max-width: 380px) {
      .screen {
        padding-left: 14px;
        padding-right: 14px;
      }

      .page-title {
        font-size: 29px;
      }

      .stat {
        padding: 15px;
      }

      .stat-value {
        font-size: 34px;
      }

      .today-name,
      .candidate-name {
        font-size: 17px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>
<body>

<div class="app">

  <!-- =======================
       TODAY
  ======================== -->
  <section class="screen active" id="screen-today">

    <header class="header">
      <div class="header-copy">
        <div class="eyebrow" id="todayEyebrow">Сегодня</div>
        <h1 class="page-title">Добрый день</h1>
        <div class="page-subtitle" id="todayDate"></div>
      </div>

      <button class="header-action" onclick="refreshAll()" aria-label="Обновить">
        <svg class="icon" viewBox="0 0 24 24">
          <path d="M20 11a8 8 0 0 0-14.9-4M4 5v5h5"></path>
          <path d="M4 13a8 8 0 0 0 14.9 4M20 19v-5h-5"></path>
        </svg>
      </button>
    </header>

    <div class="stats">
      <div class="stat">
        <div class="stat-label">Кандидаты</div>
        <div class="stat-value" id="statCandidates">—</div>
        <div class="stat-note">в базе</div>
      </div>

      <div class="stat">
        <div class="stat-label">Сегодня</div>
        <div class="stat-value" id="statToday">—</div>
        <div class="stat-note">кандидатов</div>
      </div>

      <div class="stat">
        <div class="stat-label">Новые</div>
        <div class="stat-value" id="statNew">—</div>
        <div class="stat-note">кандидаты</div>
      </div>

      <div class="stat">
        <div class="stat-label">В работе</div>
        <div class="stat-value" id="statWorking">—</div>
        <div class="stat-note">кандидаты</div>
      </div>
    </div>


    <section class="section">

      <div class="section-head">
        <h2 class="section-title">Встречи сегодня</h2>

        <button class="section-link" onclick="openScreen('meetings')">
          Все
        </button>
      </div>

      <div id="todayMeetings" class="today-list">
        <div class="loading">
          <div class="spinner"></div>
          Загружаем встречи
        </div>
      </div>

    </section>


    <section class="section">

      <div class="section-head">
        <h2 class="section-title">Кандидаты сегодня</h2>

        <button class="section-link" onclick="openScreen('candidates')">
          Все
        </button>
      </div>

      <div id="todayCandidates" class="candidate-list">
        <div class="loading">
          <div class="spinner"></div>
          Загружаем кандидатов
        </div>
      </div>

    </section>

  </section>


  <!-- =======================
       CANDIDATES
  ======================== -->
  <section class="screen" id="screen-candidates">

    <header class="header">
      <div class="header-copy">
        <div class="eyebrow">CRM</div>
        <h1 class="page-title">Кандидаты</h1>
        <div class="page-subtitle">
          Все кандидаты
        </div>
      </div>

      <button class="header-action"
              onclick="openAddCandidate()"
              aria-label="Добавить кандидата">

        <svg class="icon" viewBox="0 0 24 24">
          <path d="M12 5v14"></path>
          <path d="M5 12h14"></path>
        </svg>

      </button>
    </header>


    <div class="search">

      <svg class="icon" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 5 5"></path>
      </svg>

      <input
        id="candidateSearch"
        type="search"
        placeholder="Поиск по имени или телефону"
        autocomplete="off"
        oninput="renderCandidates()">

    </div>


    <div id="candidatesList" class="candidate-list">

      <div class="loading">
        <div class="spinner"></div>
        Загружаем кандидатов
      </div>

    </div>

  </section>


  <!-- =======================
       MEETINGS
  ======================== -->
  <section class="screen" id="screen-meetings">

    <header class="header">
      <div class="header-copy">
        <div class="eyebrow">Календарь</div>
        <h1 class="page-title">Встречи</h1>
        <div class="page-subtitle" id="meetingsPeriod"></div>
      </div>

      <button class="header-action"
              onclick="loadMeetings()"
              aria-label="Обновить встречи">

        <svg class="icon" viewBox="0 0 24 24">
          <path d="M20 11a8 8 0 0 0-14.9-4M4 5v5h5"></path>
          <path d="M4 13a8 8 0 0 0 14.9 4M20 19v-5h-5"></path>
        </svg>

      </button>
    </header>


    <div class="card" style="padding:15px;margin-bottom:14px;">

      <div style="
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:9px;
      ">

        <button class="btn btn-light"
                onclick="changeMeetingDate(-1)">
          ← Вчера
        </button>

        <button class="btn btn-light"
                onclick="changeMeetingDate(1)">
          Завтра →
        </button>

      </div>

      <button class="btn btn-dark"
              style="width:100%;margin-top:9px;"
              onclick="goTodayMeetings()">
        Сегодня
      </button>

    </div>


    <div id="meetingsList" class="meeting-list">

      <div class="loading">
        <div class="spinner"></div>
        Загружаем встречи
      </div>

    </div>

  </section>


  <!-- =======================
       OBJECTS
  ======================== -->
  <section class="screen" id="screen-objects">

    <header class="header">
      <div class="header-copy">
        <div class="eyebrow">Работа</div>
        <h1 class="page-title">Объекты</h1>
        <div class="page-subtitle">
          Объекты из CRM
        </div>
      </div>

      <button class="header-action"
              onclick="openAddObject()"
              aria-label="Добавить объект">

        <svg class="icon" viewBox="0 0 24 24">
          <path d="M12 5v14"></path>
          <path d="M5 12h14"></path>
        </svg>

      </button>
    </header>


    <div id="objectsList" class="object-list">

      <div class="loading">
        <div class="spinner"></div>
        Загружаем объекты
      </div>

    </div>

  </section>


  <!-- =======================
       MORE
  ======================== -->
  <section class="screen" id="screen-more">

    <header class="header">
      <div class="header-copy">
        <div class="eyebrow">CRM</div>
        <h1 class="page-title">Ещё</h1>

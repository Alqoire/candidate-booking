      background: linear-gradient(135deg, #17202a 0%, #1a2230 60%);
    }
    .toast.info .toast-icon {
      background: rgba(122,163,199,.2);
      color: var(--blue);
    }

    .toast.warning {
      border-color: rgba(201,166,107,.4);
      background: linear-gradient(135deg, #2a2418 0%, #1a2230 60%);
    }
    .toast.warning .toast-icon {
      background: rgba(201,166,107,.2);
      color: var(--gold);
    }

    .toast-body { flex: 1; min-width: 0; }
    .toast-title {
      font-weight: 800;
      font-size: 13px;
      margin-bottom: 4px;
    }
    .toast-text {

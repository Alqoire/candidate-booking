  ].includes(String(status || "").trim());
}

function getTodayCandidates() {
  const today = getTodayKey();

  return allCandidates
    .filter(candidate => {
      const meetingDate = parseMeetingDate(candidate.meeting);

      if (meetingDate !== today) return false;
      if (isTerminalStatus(candidate.status)) return false;

      return true;
    })
    .sort((a, b) => {
      return getMeetingTime(a.meeting).localeCompare(
        getMeetingTime(b.meeting)
      );
    });
}

/* =====================================================
   КАЛЕНДАРЬ ВСТРЕЧ
===================================================== */

const CALENDAR_MONTHS = [
  "январь", "февраль", "март", "апрель",
  "май", "июнь", "июль", "август",
  "сентябрь", "октябрь", "ноябрь", "декабрь"
];

const CALENDAR_WEEKDAYS = [
  "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"
];

function dateKey(date) {
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0")
  ].join("-");
}

function parseCalendarKey(key) {
  const parts = key.split("-").map(Number);
  return new Date(parts[0], parts[1] - 1, parts[2]);
}

function addCalendarDays(date, amount) {
  const result = new Date(date);
  result.setDate(result.getDate() + amount);
  return result;
}

function getCalendarMonday(date) {
  const result = new Date(date);
  const day = result.getDay() || 7;
  result.setDate(result.getDate() - day + 1);
  result.setHours(0, 0, 0, 0);
  return result;
}

function formatCalendarPeriod() {
  if (calendarView === "day") {
    return new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"long",
      year:"numeric"
    }).format(calendarDate);
  }

  if (calendarView === "week") {
    const monday = getCalendarMonday(calendarDate);
    const sunday = addCalendarDays(monday, 6);

    const first = new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"short"
    }).format(monday);

    const second = new Intl.DateTimeFormat("ru-RU", {
      day:"numeric",
      month:"short",
      year:"numeric"
    }).format(sunday);

    return first + " — " + second;
  }

  return CALENDAR_MONTHS[calendarDate.getMonth()] +
    " " + calendarDate.getFullYear();
}

function getCalendarRange() {
  let start;
  let end;

  if (calendarView === "day") {
    start = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth(),
      calendarDate.getDate()
    );

    end = addCalendarDays(start, 1);

  } else if (calendarView === "week") {
    start = getCalendarMonday(calendarDate);
    end = addCalendarDays(start, 7);

  } else {
    start = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth(),
      1
    );

    end = new Date(
      calendarDate.getFullYear(),
      calendarDate.getMonth() + 1,
      1
    );
  }

  return {
    start:dateKey(start),
    end:dateKey(end)
  };
}

function setCalendarView(view) {
  if (!["month", "week", "day"].includes(view)) return;

  calendarView = view;

  document.querySelectorAll(".calendar-view-btn").forEach(button => {
    button.classList.toggle(
      "active",
      button.dataset.view === view
    );
  });

  loadCalendar();
}

function changeCalendarDate(direction) {
  const next = new Date(calendarDate);

  if (calendarView === "day") {
    next.setDate(next.getDate() + direction);

  } else if (calendarView === "week") {
    next.setDate(next.getDate() + direction * 7);

  } else {
    next.setMonth(next.getMonth() + direction);
  }

  calendarDate = next;
  loadCalendar();
}

function goCalendarToday() {
  calendarDate = new Date();
  loadCalendar();
}

function loadCalendar() {
  if (!document.getElementById("calendarContent")) return;

  const requestNumber = ++calendarRequestNumber;
  const range = getCalendarRange();

  document.getElementById("calendarPeriod").textContent =
    formatCalendarPeriod();

  document.getElementById("calendarContent").innerHTML =
    '<div class="loading">Загружаем встречи...</div>';

  if (isLoadingCalendar) {
    // Предыдущий запрос не отменяем, но его результат будет проигнорирован.
  }

  isLoadingCalendar = true;

  runServer(
    "getCalendarMeetings",
    [range.start, range.end],
    result => {
      if (requestNumber !== calendarRequestNumber) return;

      isLoadingCalendar = false;

      if (!result || !result.success) {
        showCalendarError(
          result?.message || "Не удалось загрузить встречи."
        );
        return;
      }

      calendarMeetings = Array.isArray(result.meetings)
        ? result.meetings
        : [];

      renderCalendar();
    },
    error => {
      if (requestNumber !== calendarRequestNumber) return;

      isLoadingCalendar = false;

      showCalendarError(
        error?.message || "Ошибка соединения с сервером."
      );
    }
  );
}

function showCalendarError(message) {
  const content = document.getElementById("calendarContent");

  content.replaceChildren(
    makeText(
      "div",
      "empty",
      "Не удалось загрузить календарь: " + message
    )
  );
}


function formatCandidateCount(n) {
  const abs = Math.abs(Number(n) || 0);
  const mod10 = abs % 10;
  const mod100 = abs % 100;

  if (mod10 === 1 && mod100 !== 11) return abs + " кандидат";
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
    return abs + " кандидата";
  }
  return abs + " кандидатов";
}

function getCalendarMeetingClass(meeting) {
  if (meeting.status === "Отменена") return "cancelled";
  if (meeting.status === "Перенесена") return "rescheduled";
  return "planned";
}

function getCalendarMeetingCandidate(meeting) {
  const existing = allCandidates.find(candidate =>
    String(candidate.candidateId || "") ===
    String(meeting.candidateId || "")
  );

  return {
    ...(existing || {}),
    meetingId:meeting.meetingId,
    candidateId:meeting.candidateId,
    name:meeting.name || existing?.name || "Без ФИО",
    phone:meeting.phone || existing?.phone || "",
    specialty:meeting.specialty || existing?.specialty || "",
    meeting:meeting.meeting,
    status:existing?.status || "Записан",
    object:meeting.object || existing?.object || "Не указан",
    comment:meeting.comment || existing?.comment || "",
    source:meeting.source || existing?.source || ""
  };
}

function createCalendarEventButton(meeting) {
  const button = document.createElement("button");

  button.type = "button";
  button.className =
    "calendar-event " + getCalendarMeetingClass(meeting);

  button.textContent =
    meeting.time + " · " + (meeting.name || "Без ФИО");

  button.title =
    (meeting.name || "Без ФИО") + " — " +
    (meeting.specialty || "Специальность не указана") +
    " — " + meeting.status;

  button.addEventListener("click", event => {
    event.stopPropagation();
    openCalendarMeeting(meeting);
  });

  return button;
}

function renderCalendar() {
  const content = document.getElementById("calendarContent");

  document.getElementById("calendarPeriod").textContent =
    formatCalendarPeriod();

  content.replaceChildren();

  if (calendarView === "month") {
    renderCalendarMonth(content);
  } else if (calendarView === "week") {
    renderCalendarWeek(content);
  } else {
    renderCalendarDay(content);
  }

  const count = makeText(
    "div",
    "calendar-count",
    "Встреч в периоде: " + calendarMeetings.length
  );

  content.appendChild(count);
}

function renderCalendarMonth(container) {
  const grid = makeText("div", "calendar-month", "");

  CALENDAR_WEEKDAYS.forEach(day => {
    grid.appendChild(
      makeText("div", "calendar-weekday", day)
    );
  });

  const firstDay = new Date(
    calendarDate.getFullYear(),
    calendarDate.getMonth(),
    1
  );

  const start = getCalendarMonday(firstDay);
  const today = dateKey(new Date());
  const selected = dateKey(calendarDate);

  const grouped = {};

  calendarMeetings.forEach(meeting => {
    if (!grouped[meeting.date]) grouped[meeting.date] = [];
    grouped[meeting.date].push(meeting);
  });

  for (let i = 0; i < 42; i++) {
    const date = addCalendarDays(start, i);
    const key = dateKey(date);

    const classes = ["calendar-day"];

    if (date.getMonth() !== calendarDate.getMonth()) {
      classes.push("other-month");
    }

    if (key === today) classes.push("today");
    if (key === selected) classes.push("selected");

    const cell = makeText("div", classes.join(" "), "");

    const meetings = (grouped[key] || []).slice().sort((a, b) =>
      a.time.localeCompare(b.time)
    );

    const numberRow = makeText("div", "calendar-day-number", "");
    numberRow.appendChild(document.createTextNode(String(date.getDate())));

    if (meetings.length > 0) {
      const badge = makeText("span", "calendar-day-badge", String(meetings.length));

      const hasRescheduled = meetings.some(m => m.status === "Перенесена");
      const hasCancelled = meetings.some(m => m.status === "Отменена");

      if (hasCancelled) badge.classList.add("has-cancelled");
      else if (hasRescheduled) badge.classList.add("has-rescheduled");

      numberRow.appendChild(badge);
    }

    cell.appendChild(numberRow);

    if (meetings.length > 0) {
      const indicators = makeText("div", "calendar-day-indicators", "");

      // Show up to 5 status dots for quick visual density
      meetings.slice(0, 5).forEach(meeting => {
        const cls = "calendar-day-dot " + getCalendarMeetingClass(meeting);
        indicators.appendChild(makeText("span", cls.trim(), ""));
      });

      if (meetings.length > 5) {
        indicators.appendChild(
          makeText("span", "calendar-more", "+" + (meetings.length - 5))
        );
      }

      cell.appendChild(indicators);

      // Compact one-line summary of first meeting(s)
      const first = meetings[0];
      let summaryText = first.time + " · " + (first.name || "Без ФИО");
      if (meetings.length === 2) {
        summaryText += " и ещё 1";
      } else if (meetings.length > 2) {
        summaryText += " и ещё " + (meetings.length - 1);
      }

      cell.appendChild(makeText("div", "calendar-day-summary", summaryText));
    }

    cell.addEventListener("click", () => {
      calendarDate = date;
      setCalendarView("day");
    });

    grid.appendChild(cell);
  }

  container.appendChild(grid);
}

function renderCalendarWeek(container) {
  const wrapper = makeText("div", "calendar-week-wrapper", "");
  const grid = makeText("div", "calendar-week", "");

  const monday = getCalendarMonday(calendarDate);
  const today = dateKey(new Date());
  const selected = dateKey(calendarDate);

  for (let i = 0; i < 7; i++) {
    const date = addCalendarDays(monday, i);
    const key = dateKey(date);

    const column = makeText("div", "calendar-week-column", "");

    if (key === selected) column.classList.add("selected");

    const dateHeading = makeText("div", "calendar-week-date", "");

    if (key === today) dateHeading.classList.add("today");

    dateHeading.appendChild(
      makeText("strong", "", date.getDate())
    );

    dateHeading.appendChild(
      makeText(
        "span",
        "",
        CALENDAR_WEEKDAYS[i] + " · " +
        CALENDAR_MONTHS[date.getMonth()].slice(0, 3)
      )
    );

    dateHeading.addEventListener("click", () => {
      calendarDate = date;
      setCalendarView("day");
    });

    column.appendChild(dateHeading);

    const meetings = calendarMeetings
      .filter(meeting => meeting.date === key)
      .sort((a, b) => a.time.localeCompare(b.time));

    if (!meetings.length) {
      column.appendChild(
        makeText("div", "calendar-empty-day", "Нет встреч")
      );
    } else {
      // Group by time so multiple candidates at same slot stack cleanly
      const byTime = {};
      const times = [];

      meetings.forEach(meeting => {
        if (!byTime[meeting.time]) {
          byTime[meeting.time] = [];
          times.push(meeting.time);
        }
        byTime[meeting.time].push(meeting);
      });

      times.forEach(time => {
        const list = byTime[time];

        if (list.length === 1) {
          column.appendChild(createCalendarEventButton(list[0]));
        } else {
          const groupLabel = makeText(
            "div",
            "calendar-more",
            time + " · " + formatCandidateCount(list.length)
          );
          groupLabel.style.marginBottom = "3px";
          groupLabel.style.color = "var(--gold)";
          groupLabel.style.fontWeight = "700";
          column.appendChild(groupLabel);

          list.forEach(meeting => {
            const btn = createCalendarEventButton(meeting);
            // Avoid repeating time in stacked list
            btn.textContent = meeting.name || "Без ФИО";
            column.appendChild(btn);
          });
        }
      });
    }

    grid.appendChild(column);
  }

  wrapper.appendChild(grid);
  container.appendChild(wrapper);
}

function renderCalendarDay(container) {
  const layout = makeText("div", "calendar-day-layout", "");

  const heading = makeText(
    "div",
    "calendar-day-heading",
    new Intl.DateTimeFormat("ru-RU", {
      weekday:"long",
      day:"numeric",
      month:"long",
      year:"numeric"
    }).format(calendarDate)
  );

  layout.appendChild(heading);

  const selectedKey = dateKey(calendarDate);

  const meetings = calendarMeetings
    .filter(meeting => meeting.date === selectedKey)
    .sort((a, b) => a.time.localeCompare(b.time));

  if (!meetings.length) {
    layout.appendChild(
      makeText(
        "div",
        "calendar-empty-day",
        "На выбранную дату встреч нет."
      )
    );

    container.appendChild(layout);
    return;
  }

  const grouped = {};
  const times = [];

  meetings.forEach(meeting => {
    if (!grouped[meeting.time]) {
      grouped[meeting.time] = [];
      times.push(meeting.time);
    }
    grouped[meeting.time].push(meeting);
  });

  times.sort((a, b) => a.localeCompare(b));

  times.forEach(time => {
    const list = grouped[time];
    const group = makeText("div", "calendar-time-group", "");

    const header = makeText("div", "calendar-time-group-header", "");
    header.appendChild(document.createTextNode(time));

    header.appendChild(makeText("span", "", formatCandidateCount(list.length)));

    group.appendChild(header);

    const body = makeText("div", "calendar-time-group-body", "");

    list.forEach(meeting => {
      // In day view show name + specialty without repeating time
      const button = document.createElement("button");
      button.type = "button";
      button.className = "calendar-event " + getCalendarMeetingClass(meeting);

      const name = meeting.name || "Без ФИО";
      const specialty = meeting.specialty || "Специальность не указана";
      button.textContent = name + " · " + specialty;

      button.title =
        name + " — " + specialty + " — " + (meeting.status || "");

      button.addEventListener("click", event => {
        event.stopPropagation();
        openCalendarMeeting(meeting);
      });

      body.appendChild(button);
    });

    group.appendChild(body);
    layout.appendChild(group);
  });

  container.appendChild(layout);
}

function openCalendarMeeting(meeting) {
  const candidate = getCalendarMeetingCandidate(meeting);

  const old = document.getElementById("calendarMeetingModal");
  if (old) old.remove();

  const overlay = document.createElement("div");
  overlay.id = "calendarMeetingModal";

  Object.assign(overlay.style, {
    position:"fixed",
    inset:"0",
    zIndex:"100000",
    display:"flex",
    alignItems:"center",
    justifyContent:"center",
    padding:"18px",
    background:"rgba(5,10,20,.82)",
    backdropFilter:"blur(5px)"
  });

  const modal = document.createElement("div");

  Object.assign(modal.style, {
    width:"100%",
    maxWidth:"430px",
    maxHeight:"90vh",
    overflowY:"auto",
    padding:"24px",
    borderRadius:"16px",
    border:"1px solid #46536a",
    background:"#1a2230",
    color:"#edf0f5",
    boxShadow:"0 25px 80px rgba(0,0,0,.5)"
  });

  const header = makeText("div", "", "");
  Object.assign(header.style, {
    display:"flex",
    justifyContent:"space-between",
    alignItems:"center",
    gap:"12px",
    marginBottom:"20px"
  });

  header.appendChild(
    makeText("div", "", "Информация о встрече")
  );

  const close = makeText("button", "", "×");
  close.type = "button";

  Object.assign(close.style, {
    border:"0",
    background:"transparent",
    color:"#8995a8",
    fontSize:"26px",
    cursor:"pointer"
  });

  header.appendChild(close);
  modal.appendChild(header);

  const fields = [
    ["Кандидат", candidate.name],
    ["Телефон", candidate.phone || "Не указан"],
    ["Специальность", candidate.specialty || "Не указана"],
    ["Дата", meeting.meeting],
    ["Статус встречи", meeting.status || "Не указан"],
    ["Статус кандидата", candidate.status || "Не указан"],
    ["Объект", candidate.object || "Не указан"],
    ["Источник", candidate.source || "Не указан"],
    ["Комментарий", candidate.comment || "Нет комментария"]
  ];

  fields.forEach(([label, value]) => {
    const item = makeText("div", "", "");

    Object.assign(item.style, {
      padding:"10px 0",
      borderBottom:"1px solid #2b3545"
    });

    item.appendChild(
      makeText("div", "", label)
    );

    const valueElement = makeText("div", "", value);

    Object.assign(valueElement.style, {
      color:"#cbd2dd",
      fontSize:"13px",
      marginTop:"5px",
      overflowWrap:"anywhere"
    });

    item.appendChild(valueElement);
    modal.appendChild(item);
  });

  const actions = makeText("div", "", "");

  Object.assign(actions.style, {
    display:"flex",
    flexWrap:"wrap",
    gap:"8px",
    marginTop:"20px"
  });

  if (candidate.phone) {
    const call = makeText("a", "quick-btn call", "☎ Позвонить");
    call.href = "tel:" + normalizePhone(candidate.phone);
    actions.appendChild(call);

    const copy = makeText("button", "quick-btn copy", "▣ Копировать номер");
    copy.type = "button";
    copy.addEventListener("click", async () => {
      if (await copyPhone(candidate.phone)) {
        copy.textContent = "✓ Скопировано";
      }
    });

    actions.appendChild(copy);
  }

  if (meeting.status !== "Отменена") {
    const reschedule = makeText(
      "button",
      "secondary-btn",
      "Перенести"
    );

    reschedule.type = "button";

    reschedule.addEventListener("click", () => {
      overlay.remove();
      openRescheduleDialog(candidate);
    });

    actions.appendChild(reschedule);

    const cancel = makeText(
      "button",
      "secondary-btn",
      "Отменить встречу"
    );

    cancel.type = "button";
    cancel.style.color = "#FF8585";

    cancel.addEventListener("click", () => {
      overlay.remove();
      openCancelDialog(candidate);
    });

    actions.appendChild(cancel);
  }

  modal.appendChild(actions);

  overlay.appendChild(modal);
  document.body.appendChild(overlay);

  function closeModal() {
    overlay.remove();
    document.removeEventListener("keydown", escapeHandler);
  }

  const escapeHandler = event => {
    if (event.key === "Escape") closeModal();
  };

  close.addEventListener("click", closeModal);

  overlay.addEventListener("click", event => {
    if (event.target === overlay) closeModal();
  });

  document.addEventListener("keydown", escapeHandler);
}

function showPage(page) {
  if (!pageTitles[page]) return;

  document.querySelectorAll(".page").forEach(element => {
    element.classList.remove("active");
  });

  document.getElementById("page-" + page).classList.add("active");

  document.querySelectorAll(".nav-btn").forEach(button => {
    button.classList.toggle("active", button.dataset.page === page);
  });

  document.getElementById("pageTitle").textContent = pageTitles[page];

  window.scrollTo({ top:0, behavior:"smooth" });

  if (page === "candidates") renderCandidates();
  if (page === "dashboard") renderTodayCandidates();
  if (page === "calendar") loadCalendar();
  if (page === "analytics") loadRecruitmentAnalytics();
}

document.querySelectorAll(".nav-btn").forEach(button => {
  button.addEventListener("click", () => showPage(button.dataset.page));
});


function handleAnalyticsPeriodChange() {
  const period = document.getElementById("analyticsPeriod").value;
  const custom = period === "custom";

  document.getElementById("analyticsDateStart").style.display =
    custom ? "" : "none";

  document.getElementById("analyticsDateEnd").style.display =
    custom ? "" : "none";
}

function loadRecruitmentAnalytics() {
  const period = document.getElementById("analyticsPeriod").value;

  const filters = { period };

  if (period === "custom") {
    const start = document.getElementById("analyticsDateStart").value;
    const end = document.getElementById("analyticsDateEnd").value;

    if (!start || !end) {
      showToast("Выберите обе даты периода", "warning");
      return;
    }

    if (start > end) {
      showToast("Начальная дата не может быть позже конечной", "warning");
      return;
    }

    filters.startDate = start;
    filters.endDate = end;
  }

  const content = document.getElementById("analyticsContent");
  content.innerHTML = '<div class="loading">Загружаем аналитику...</div>';

  runServer(
    "getRecruitmentAnalytics",
    [filters],
    function(result) {
      if (!result || !result.success) {
        content.textContent = "Не удалось получить аналитику";
        showToast("Ошибка загрузки аналитики", "error");
        return;
      }

      renderRecruitmentAnalytics(result);
    },
    function(error) {
      content.textContent =
        error && error.message
          ? error.message
          : "Ошибка загрузки аналитики";

      showToast("Не удалось загрузить аналитику", "error");
    }
  );
}


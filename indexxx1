  textarea.placeholder =
    "Например: созвонились, готов приехать в пятницу...";

  Object.assign(textarea.style, {
    display: "block",
    width: "100%",
    minHeight: "95px",
    marginTop: "10px",
    padding: "12px",
    resize: "vertical",
    borderRadius: "9px",
    border: "1px solid #354258",
    background: "#121923",
    color: "#eef1f6",
    font: "inherit",
    fontSize: "12px",
    outline: "none"
  });


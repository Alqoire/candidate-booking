function changeMeetingDate(days) {

  currentMeetingDate =
    new Date(
      currentMeetingDate
    );


  currentMeetingDate.setDate(
    currentMeetingDate.getDate() + days
  );


  loadMeetings();
}


function goTodayMeetings() {

  currentMeetingDate =
    new Date();

  loadMeetings();
}


/* =========================================================
   ПЕРЕНОС
========================================================= */

function openReschedule(
  meetingId,
  date,
  time
) {

  $("rescheduleMeetingId").value =
    meetingId || "";


  $("rescheduleDate").value =
    date
      ? String(date).slice(0, 10)
      : getCurrentMeetingYmd();


  $("rescheduleTime").value =
    time || "10:00";


  $("rescheduleReason").value =
    "";


  openModal(
    "rescheduleModal"
  );
}


async function submitReschedule(event) {

  event.preventDefault();


  const meetingId =
    $("rescheduleMeetingId").value;


  const newDate =
    $("rescheduleDate").value;


  const newTime =
    $("rescheduleTime").value;


  const reason =
    $("rescheduleReason").value.trim();


  if (!meetingId) {
    showToast(
      "Не найдена встреча",
      "error"
    );
    return;
  }


  if (!newDate || !newTime) {
    showToast(
      "Укажите дату и время",
      "error"
    );
    return;
  }


  try {

    const result =
      await serverCall(
        "rescheduleMeeting",
        meetingId,
        newDate,
        newTime,
        reason
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось перенести встречу"
      );
    }


    closeModal(
      "rescheduleModal"
    );


    showToast(
      "Встреча перенесена",
      "success"
    );


    await refreshAll();


    if (
      $("screen-meetings")?.classList.contains(
        "active"
      )
    ) {
      loadMeetings();
    }


  } catch (error) {

    console.error(
      "rescheduleMeeting:",
      error
    );

    showToast(
      error.message ||
      "Не удалось перенести встречу",
      "error"
    );
  }
}


/* =========================================================
   ОТМЕНА
========================================================= */

function openCancel(meetingId) {

  $("cancelMeetingId").value =
    meetingId || "";


  $("cancelReason").value =
    "";


  openModal(
    "cancelModal"
  );
}


async function submitCancel(event) {

  event.preventDefault();


  const meetingId =
    $("cancelMeetingId").value;


  const reason =
    $("cancelReason").value.trim();


  if (!meetingId) {
    showToast(
      "Не найдена встреча",
      "error"
    );
    return;
  }


  if (!reason) {
    showToast(
      "Укажите причину отмены",
      "error"
    );
    return;
  }


  try {

    const result =
      await serverCall(
        "cancelMeeting",
        meetingId,
        reason
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось отменить встречу"
      );
    }


    closeModal(
      "cancelModal"
    );


    showToast(
      "Встреча отменена",
      "success"
    );


    await refreshAll();


    if (
      $("screen-meetings")?.classList.contains(
        "active"
      )
    ) {
      loadMeetings();
    }


  } catch (error) {

    console.error(
      "cancelMeeting:",
      error
    );

    showToast(
      error.message ||
      "Не удалось отменить встречу",
      "error"
    );
  }
}


/* =========================================================
   ОБЪЕКТЫ
========================================================= */

async function loadObjects() {

  setLoading(
    "objectsList",
    "Загружаем объекты"
  );


  try {

    const result =
      await serverCall(
        "getObjects"
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось загрузить объекты"
      );
    }


    if (
      result &&
      Array.isArray(result.objects)
    ) {

      objects =
        result.objects;

    } else if (
      Array.isArray(result)
    ) {

      objects = result;

    } else {

      objects = [];

    }


    renderObjects();


  } catch (error) {

    console.error(
      "loadObjects:",
      error
    );


    $("objectsList").innerHTML = `
      <div class="card empty">
        <strong>Ошибка загрузки</strong>
        ${escapeHtml(
          error.message ||
          "Не удалось загрузить объекты"
        )}
      </div>
    `;

  }
}


function renderObjects() {

  const container =
    $("objectsList");

  if (!container) return;


  if (!objects.length) {

    container.innerHTML = `
      <div class="card empty">
        <strong>Объектов пока нет</strong>
        Добавьте первый объект.
      </div>
    `;

    return;
  }


  container.innerHTML =
    objects
      .map(object => {

        const name =
          typeof object === "string"
            ? object
            : (
                object.name ||
                object.objectName ||
                object.title ||
                ""
              );


        if (!name) return "";


        return `
          <div class="object-card">
            ${escapeHtml(name)}
          </div>
        `;

      })
      .join("");
}


function openAddObject() {

  $("newObjectName").value =
    "";

  openModal(
    "objectModal"
  );
}


async function submitObject(event) {

  event.preventDefault();


  const input =
    $("newObjectName");


  const objectName =
    input.value.trim();


  if (!objectName) {
    showToast(
      "Введите название объекта",
      "error"
    );
    return;
  }


  const submit =
    event.submitter;


  if (submit) {
    submit.disabled = true;
    submit.textContent =
      "Добавляем...";
  }


  try {

    const result =
      await serverCall(
        "addObject",
        objectName
      );


    if (
      result &&
      result.success === false
    ) {
      throw new Error(
        result.error ||
        "Не удалось добавить объект"
      );
    }


    closeModal(
      "objectModal"
    );


    showToast(
      "Объект добавлен",
      "success"
    );


    await loadObjects();


  } catch (error) {

    console.error(
      "addObject:",
      error
    );

    showToast(
      error.message ||
      "Не удалось добавить объект",
      "error"
    );


  } finally {

    if (submit) {
      submit.disabled = false;
      submit.textContent =
        "Добавить объект";
    }

  }
}


/* =========================================================
   ДЕЙСТВИЯ СО ВСТРЕЧЕЙ
========================================================= */

function openMeetingActions(meetingId) {

  if (!meetingId) {
    showToast(
      "У встречи нет ID",
      "error"
    );
    return;
  }


  const meeting =
    todayMeetings.find(item =>
      String(
        item.meetingId ||
        item.id ||
        ""
      ) === String(meetingId)
    );


  if (!meeting) {
    showToast(
      "Встреча не найдена",
      "error"
    );
    return;
  }


  const date =
    meeting.date ||
    meeting.startDate ||
    getTodayYmd();


  const time =
    formatTime(
      meeting.time ||
      meeting.startTime ||
      meeting.start
    );


  openReschedule(
    meetingId,
    date,
    time
  );
}


/* =========================================================
   MODALS
========================================================= */

function openModal(id) {

  const modal = $(id);

  if (!modal) return;

  modal.classList.add("open");

  document.body.style.overflow =
    "hidden";
}


function closeModal(id) {

  const modal = $(id);

  if (!modal) return;

  modal.classList.remove("open");

  const opened =
    document.querySelector(
      ".modal.open"
    );

  if (!opened) {
    document.body.style.overflow =
      "";
  }
}


document
  .querySelectorAll(".modal")
  .forEach(modal => {

    modal.addEventListener(
      "click",
      event => {

        if (
          event.target === modal
        ) {
          closeModal(
            modal.id
          );
        }

      }
    );

  });


document.addEventListener(
  "keydown",
  event => {

    if (
      event.key !== "Escape"
    ) {
      return;
    }


    const modal =
      document.querySelector(
        ".modal.open"
      );


    if (modal) {
      closeModal(
        modal.id
      );
    }

  }
);


/* =========================================================
   REFRESH
========================================================= */

async function refreshAll() {

  try {

    await Promise.all([
      loadToday(),
      loadObjects()
    ]);


    if (
      $("screen-candidates")?.classList.contains(
        "active"
      )
    ) {
      await loadCandidates();
    }


    if (
      $("screen-meetings")?.classList.contains(
        "active"
      )
    ) {
      await loadMeetings();
    }


  } catch (error) {

    console.error(
      "refreshAll:",
      error
    );

  }
}


